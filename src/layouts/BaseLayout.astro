---
// Basis-Seitenlayout für alle Seiten der Website
import '../styles/global.css';
import { DEMO_MODE } from '../config';
import texte from '../content/texte.json';
import DemoBalken from '../components/DemoBalken.astro';
import HinweisBanner from '../components/HinweisBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileAktionsleiste from '../components/MobileAktionsleiste.astro';

interface Props {
  title: string;
  description?: string;
  headerTransparent?: boolean;
  headerVariante?: 'standard' | 'unterseite';
  headerTitel?: string;
  aktiv?: 'home' | 'speisekarte' | string;
}

const {
  title,
  description = '',
  headerTransparent = false,
  headerVariante = 'standard',
  headerTitel = '',
  aktiv = '',
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!doctype html>
<!-- hat-hero: Seite hat einen Hero (Startseite). Ohne Hero sind "nach-hero" und "gescrollt" sofort gesetzt. -->
<html
  lang="de"
  class:list={[
    headerTransparent ? 'hat-hero' : ['nach-hero', 'gescrollt'],
    DEMO_MODE && 'mit-demo',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {DEMO_MODE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <meta name="theme-color" content="#c40010" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Seitenübergänge: Rendern warten, bis der Inhalt geparst ist, damit das Morph-Ziel existiert -->
    <link rel="expect" href="#vt-bereit" blocking="render" />
    <!--
      Seitenübergang auf der NEUEN Seite (pagereveal). Muss ein klassisches Inline-Skript im <head> sein:
      pagereveal feuert vor dem ersten Rendern – ein Modul-Skript (type=module, verzögert) käme zu spät,
      dann fällt der Browser auf Überblenden zurück. Gegenstück (Klick + pageswap): scripts/seitenuebergang.ts
    -->
    <script is:inline define:vars={{ vtBase: base }}>
      (function () {
        var SCHLUESSEL = 'pizzeria-vt';
        var MORPH = 'kategorie-morph';
        function pfad(u) { try { var p = new URL(u, location.href).pathname.replace(/\/+$/, ''); return p || '/'; } catch (e) { return ''; } }
        var basis = (vtBase || '/').replace(/\/+$/, '') || '/';
        function istKarte(u) { return !!u && pfad(u).slice(-12) === '/speisekarte'; }
        function istStart(u) { return !!u && pfad(u) === basis; }
        function lese() {
          try { var d = JSON.parse(sessionStorage.getItem(SCHLUESSEL) || 'null'); sessionStorage.removeItem(SCHLUESSEL);
            return d && Date.now() - d.ts < 4000 ? d : null; } catch (e) { return null; }
        }
        function aufraeumen() {
          var el = document.querySelectorAll('[data-vt-morph]');
          for (var i = 0; i < el.length; i++) { el[i].style.viewTransitionName = ''; el[i].removeAttribute('data-vt-morph'); }
        }
        window.addEventListener('pagereveal', function (e) {
          var vt = e.viewTransition;
          var gespeichert = lese();
          if (!vt) return;
          var act = window.navigation && window.navigation.activation;
          var von = act && act.from && act.from.url;
          var hier = location.href;
          if (istKarte(hier)) {
            if (location.hash) window.__einblendenSofort = true;
            if (gespeichert && gespeichert.typ === 'morph' && gespeichert.katId) {
              var sek = document.querySelector('[data-kategorie-sektion="' + gespeichert.katId + '"]');
              var block = sek && sek.querySelector('[data-kategorie-block]');
              if (block && !sek.hidden) {
                sek.scrollIntoView({ behavior: 'instant', block: 'start' });
                block.style.viewTransitionName = MORPH;
                block.setAttribute('data-vt-morph', '1');
                vt.types.add('morph');
                vt.finished.finally(aufraeumen);
                return;
              }
            }
            if (!von || istStart(von) || (gespeichert && gespeichert.typ === 'vor')) vt.types.add('vor');
          } else if (istStart(hier)) {
            if ((von && istKarte(von)) || (gespeichert && gespeichert.typ === 'zurueck')) vt.types.add('zurueck');
          }
          vt.finished.finally(aufraeumen);
        });
      })();
    </script>
    <script>
      import '../scripts/scroll-zustand.ts';
      import '../scripts/einblenden.ts';
      import '../scripts/seitenuebergang.ts';
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link auf-rot" href="#inhalt">{texte.layout.skipLink}</a>

    <DemoBalken />
    <HinweisBanner />

    <!-- Anker direkt unter DemoBalken/HinweisBanner für die exakte top-Position des fixed Headers -->
    <div
      class:list={[
        'header-anker',
        headerTransparent ? 'header-anker--transparent' : 'header-anker--fest',
      ]}
      data-header-anker
    >
      <Header
        transparent={headerTransparent}
        aktiv={aktiv}
        variante={headerVariante}
        unterseiteTitel={headerTitel}
      />
    </div>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <div id="vt-bereit" hidden></div>

    <Footer />
    <MobileAktionsleiste />
  </body>
</html>

<style>
  .header-anker {
    position: relative;
  }

  /* Unterseiten: Platzhalter in Leistenhöhe, damit der fixed Header keinen Inhalt verdeckt */
  .header-anker--fest {
    height: var(--aktuelle-leiste-hoehe);
  }

  :global(html:not(.js)) .header-anker--fest {
    height: auto;
  }
</style>

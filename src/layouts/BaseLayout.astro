---
// Basis-Seitenlayout für alle Seiten der Website
import '../styles/global.css';
import { DEMO_MODE } from '../config';
import DemoBalken from '../components/DemoBalken.astro';
import HinweisBanner from '../components/HinweisBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileAktionsleiste from '../components/MobileAktionsleiste.astro';

interface Props {
  title: string;
  description?: string;
  headerTransparent?: boolean;
  aktiv?: 'home' | 'speisekarte' | string;
}

const {
  title,
  description = '',
  headerTransparent = false,
  aktiv = '',
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {DEMO_MODE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <meta name="theme-color" content="#c40010" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link auf-rot" href="#inhalt">Zum Inhalt springen</a>

    <DemoBalken />
    <HinweisBanner />

    <!-- Relativer Anker, damit ein transparenter Header exakt unter DemoBalken/HinweisBanner liegt -->
    <div class:list={['header-anker', headerTransparent && 'header-anker--transparent']}>
      <Header transparent={headerTransparent} aktiv={aktiv} />
    </div>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <MobileAktionsleiste />
  </body>
</html>

<style>
  .header-anker--transparent {
    position: relative;
    z-index: 20;
  }
</style>

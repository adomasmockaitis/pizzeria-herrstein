---
// Abschnitt "Lieferkosten" mit Live-Ortssuche, abwechselnd farbigen Zonen-Karten und Fallback-Hinweis
import { Image } from 'astro:assets';
import AbschnittTitel from '../AbschnittTitel.astro';
import Button from '../Button.astro';
import Karte from '../Karte.astro';
import kontakt from '../../content/kontakt.json';
import lieferzonen from '../../content/lieferzonen.json';
import texte from '../../content/texte.json';
import lupeIcon from '../../assets/icons/lupe.png';
import lieferautoMockup from '../../assets/mockups/lieferauto.webp';

const sichtbareZonen = lieferzonen.zonen.filter((zone) => zone.sichtbar);
---

<section
  class="lieferkosten"
  id="lieferkosten"
  aria-labelledby="lieferkosten-titel"
  data-status-alle={texte.lieferkosten.statusAlle}
  data-status-singular={texte.lieferkosten.statusTrefferSingular}
  data-status-plural={texte.lieferkosten.statusTrefferPlural}
  data-status-leer={texte.lieferkosten.statusKeinTreffer}
  data-anzahl-gesamt={sichtbareZonen.length}
>
  <div class="container">
    <div class="lieferkosten__kopf" data-einblenden>
      <AbschnittTitel id="lieferkosten-titel" farbe="rot">
        {texte.lieferkosten.ueberschrift}
      </AbschnittTitel>
      <p class="lieferkosten__untertitel">{texte.lieferkosten.untertitel}</p>
    </div>

    <div class="lieferkosten__suche">
      <label for="lieferzonen-suche" class="visually-hidden">
        {texte.lieferkosten.suchfeldLabel}
      </label>
      <Image
        src={lupeIcon}
        alt=""
        width={22}
        height={22}
        loading="lazy"
        class="lieferkosten__lupe"
        aria-hidden="true"
      />
      <input
        id="lieferzonen-suche"
        type="search"
        inputmode="search"
        autocomplete="off"
        placeholder={texte.lieferkosten.suchfeldPlatzhalter}
        class="lieferkosten__eingabe auf-rot"
        data-zonen-suche
      />
      <button
        type="button"
        class="lieferkosten__leeren auf-rot"
        hidden
        data-suche-leeren
        aria-label={texte.lieferkosten.sucheLeerenLabel}
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-suche-status></p>

    <div class="lieferkosten__zonen" data-einblenden>
      <!-- Deko-Lieferauto (nur >= 1024px): steht wie in Figma links unten an der letzten Zonen-Karte -->
      <div class="lieferkosten__auto" aria-hidden="true">
        <Image
          src={lieferautoMockup}
          alt=""
          widths={[360, 560, 960]}
          sizes="(min-width: 1024px) 440px, 0px"
          loading="lazy"
          class="lieferkosten__auto-bild"
        />
      </div>

    <div class="lieferkosten__grid" data-zonen-grid>
      {sichtbareZonen.map((zone, index) => {
        const farbe = index % 2 === 0 ? 'gruen' : 'rot';
        const badgeFarbe = farbe === 'gruen' ? 'rot' : 'gruen';
        const preisText = `${zone.preis}\u202F€`;

        return (
          <Karte farbe={farbe} schatten class="zone-karte" data-zone-karte>
            <h3 class="zone-karte__titel">
              {texte.lieferkosten.zonePrefix} {zone.id}
            </h3>
            <p class="zone-karte__orte">
              {zone.orte.map((ort, ortIndex) => (
                <>
                  <span class="zone-karte__ort" data-ort={ort}>
                    {ort}
                  </span>
                  {ortIndex < zone.orte.length - 1 && ', '}
                </>
              ))}
            </p>
            <span class:list={['zone-karte__preis', `zone-karte__preis--${badgeFarbe}`]}>
              {preisText}
            </span>
          </Karte>
        );
      })}
    </div>

    </div>

    <div class="lieferkosten__leer" hidden data-zonen-leer>
      <p class="lieferkosten__leer-text">{lieferzonen.keinTrefferText}</p>
      <Button href={kontakt.telefon.link} variante="rot" groesse="klein" icon="telefon">
        {texte.lieferservice.telefonButton}
      </Button>
    </div>
  </div>
</section>

<script>
  interface Normalisiert {
    text: string;
    indexMap: Array<[number, number]>;
  }

  function normalisiereMitIndex(eingabe: string): Normalisiert {
    let text = '';
    const indexMap: Array<[number, number]> = [];

    for (let i = 0; i < eingabe.length; i++) {
      const roh = eingabe[i].toLowerCase();
      if (/[\s-]/.test(roh)) {
        continue;
      }

      if (roh === 'ß') {
        text += 'ss';
        indexMap.push([i, i + 1], [i, i + 1]);
        continue;
      }

      const basis = roh.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      for (const zeichen of basis) {
        if (!/[\s-]/.test(zeichen)) {
          text += zeichen;
          indexMap.push([i, i + 1]);
        }
      }
    }

    return { text, indexMap };
  }

  function erzeugeAnfrageVarianten(eingabe: string): string[] {
    const { text } = normalisiereMitIndex(eingabe);
    if (!text) return [];

    const umlautErsetzt = text
      .replace(/ae/g, 'a')
      .replace(/oe/g, 'o')
      .replace(/ue/g, 'u');

    return umlautErsetzt !== text ? [text, umlautErsetzt] : [text];
  }

  function berechneTrefferBereich(
    ort: string,
    anfragen: string[],
  ): [number, number] | null {
    const { text, indexMap } = normalisiereMitIndex(ort);
    if (!text) return null;

    for (const anfrage of anfragen) {
      const pos = text.indexOf(anfrage);
      if (pos !== -1) {
        const start = indexMap[pos]?.[0] ?? 0;
        const ende = indexMap[pos + anfrage.length - 1]?.[1] ?? ort.length;
        return [start, ende];
      }
    }

    return null;
  }

  function setzeOrtHervorhebung(element: HTMLElement, ort: string, bereich: [number, number] | null) {
    element.textContent = '';
    if (!bereich) {
      element.textContent = ort;
      return;
    }

    const [start, ende] = bereich;
    if (start > 0) {
      element.appendChild(document.createTextNode(ort.slice(0, start)));
    }
    const mark = document.createElement('mark');
    mark.className = 'zone-karte__treffer';
    mark.textContent = ort.slice(start, ende);
    element.appendChild(mark);
    if (ende < ort.length) {
      element.appendChild(document.createTextNode(ort.slice(ende)));
    }
  }

  const sektion = document.querySelector<HTMLElement>('.lieferkosten');
  const eingabe = sektion?.querySelector<HTMLInputElement>('[data-zonen-suche]');
  const leerenBtn = sektion?.querySelector<HTMLButtonElement>('[data-suche-leeren]');
  const statusEl = sektion?.querySelector<HTMLElement>('[data-suche-status]');
  const leerBox = sektion?.querySelector<HTMLElement>('[data-zonen-leer]');

  if (sektion && eingabe && statusEl && leerBox) {
    const karten = Array.from(sektion.querySelectorAll<HTMLElement>('.zone-karte')).map(
      (karte) => ({
        karte,
        passt: true,
        orte: Array.from(karte.querySelectorAll<HTMLElement>('[data-ort]')).map((el) => ({
          el,
          ort: el.dataset.ort ?? '',
        })),
      }),
    );

    const statusAlle = sektion.dataset.statusAlle ?? '';
    const statusSingular = sektion.dataset.statusSingular ?? '';
    const statusPlural = sektion.dataset.statusPlural ?? '';
    const statusLeer = sektion.dataset.statusLeer ?? '';
    const anzahlGesamt = sektion.dataset.anzahlGesamt ?? String(karten.length);

    let statusTimer: number | undefined;

    const meldeStatus = (trefferKarten: number, hatSuche: boolean, sofort: boolean) => {
      window.clearTimeout(statusTimer);
      const schreiben = () => {
        if (!hatSuche) {
          statusEl.textContent = statusAlle.replace('{anzahl}', anzahlGesamt);
        } else if (trefferKarten === 0) {
          statusEl.textContent = statusLeer;
        } else if (trefferKarten === 1) {
          statusEl.textContent = statusSingular;
        } else {
          statusEl.textContent = statusPlural.replace('{anzahl}', String(trefferKarten));
        }
      };

      if (sofort) {
        schreiben();
      } else {
        statusTimer = window.setTimeout(schreiben, 250);
      }
    };

    // ---------- Animation (FLIP, nur transform/opacity/height) ----------
    const zonenBox = sektion.querySelector<HTMLElement>('.lieferkosten__zonen');
    const DAUER_AUS = 180;
    const DAUER_EIN = 220;
    const DAUER_VERSATZ = 30;
    const DAUER_BEWEGUNG = 280;
    const DAUER_LEER = 200;
    const KURVE_BEWEGUNG = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
    const VERSTECKT = { opacity: 0, transform: 'scale(0.96) translateY(8px)' };
    const NORMAL = { opacity: 1, transform: 'scale(1) translateY(0)' };

    interface Momentaufnahme {
      rects: Map<HTMLElement, DOMRect>;
      deckkraft: Map<HTMLElement, number>;
      hoehe: number;
    }

    let laufende: Animation[] = [];
    let generation = 0;
    let animationsTimer: number | undefined;
    let leerSoll = false;

    const reduzierteBewegung = () =>
      !zonenBox ||
      typeof zonenBox.animate !== 'function' ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const sichtbareKarten = () => karten.filter((e) => !e.karte.hidden).map((e) => e.karte);

    const merke = (): Momentaufnahme => {
      const rects = new Map<HTMLElement, DOMRect>();
      const deckkraft = new Map<HTMLElement, number>();
      for (const karte of sichtbareKarten()) {
        rects.set(karte, karte.getBoundingClientRect());
        deckkraft.set(karte, parseFloat(getComputedStyle(karte).opacity));
      }
      return { rects, deckkraft, hoehe: zonenBox?.getBoundingClientRect().height ?? 0 };
    };

    const stoppeAnimationen = () => {
      for (const a of laufende) a.cancel();
      laufende = [];
    };

    const starte = (el: HTMLElement, keyframes: Keyframe[], optionen: KeyframeAnimationOptions) => {
      const a = el.animate(keyframes, optionen);
      laufende.push(a);
      return a;
    };

    // FLIP: alte Position/Höhe -> neue Position/Höhe gleiten; neue Karten blenden gestaffelt ein
    const bewegeVon = (alt: Momentaufnahme, neueKarten: HTMLElement[] = []) => {
      for (const karte of sichtbareKarten()) {
        const vorher = alt.rects.get(karte);
        if (!vorher) {
          const nr = neueKarten.indexOf(karte);
          starte(karte, [VERSTECKT, NORMAL], {
            duration: DAUER_EIN,
            delay: Math.max(nr, 0) * DAUER_VERSATZ,
            easing: 'ease-out',
            fill: 'backwards',
          });
          continue;
        }
        const jetzt = karte.getBoundingClientRect();
        const dx = vorher.left - jetzt.left;
        const dy = vorher.top - jetzt.top;
        if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
          starte(karte, [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }], {
            duration: DAUER_BEWEGUNG,
            easing: KURVE_BEWEGUNG,
          });
        }
        const start = alt.deckkraft.get(karte) ?? 1;
        if (start < 0.99) {
          starte(karte, [{ opacity: start }, { opacity: 1 }], { duration: DAUER_EIN, easing: 'ease-out' });
        }
      }

      if (zonenBox) {
        const neueHoehe = zonenBox.getBoundingClientRect().height;
        if (Math.abs(alt.hoehe - neueHoehe) > 1) {
          // explizite Höhe nur während der Animation, danach wieder auto (kein fill)
          starte(zonenBox, [{ height: `${alt.hoehe}px` }, { height: `${neueHoehe}px` }], {
            duration: DAUER_BEWEGUNG,
            easing: KURVE_BEWEGUNG,
          });
        }
      }
    };

    // Eigene Animation für den Leer-Hinweis: wird NICHT von stoppeAnimationen() abgebrochen,
    // sonst bliebe der Hinweis nach dem Leeren der Suche sichtbar stehen.
    let leerAnimation: Animation | undefined;

    const zeigeLeerBox = () => {
      leerAnimation?.cancel();
      leerAnimation = undefined;
      if (!leerBox.hidden) return;
      leerBox.hidden = false;
      starte(leerBox, [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }], {
        duration: DAUER_LEER,
        easing: 'ease-out',
        fill: 'backwards',
      });
    };

    const verbergeLeerBox = () => {
      if (leerBox.hidden || leerAnimation) return;
      const a = leerBox.animate(
        [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(8px)' }],
        { duration: DAUER_LEER, easing: 'ease-in', fill: 'forwards' },
      );
      leerAnimation = a;
      a.finished.then(
        () => {
          if (leerAnimation === a) {
            if (!leerSoll) leerBox.hidden = true;
            a.cancel(); // fill aufheben, damit der Hinweis beim nächsten Mal normal erscheint
            leerAnimation = undefined;
          }
        },
        () => {},
      );
    };

    // Farben immer nach SICHTBARER Reihenfolge: 1. grün, 2. rot, 3. grün … (Desktop: links grün, rechts rot).
    // Das Preis-Badge bekommt jeweils die Gegenfarbe.
    const faerbeNachReihenfolge = () => {
      let n = 0;
      for (const e of karten) {
        if (e.karte.hidden) continue;
        const gruen = n % 2 === 0;
        e.karte.classList.toggle('karte--gruen', gruen);
        e.karte.classList.toggle('karte--rot', !gruen);
        const preis = e.karte.querySelector('.zone-karte__preis');
        preis?.classList.toggle('zone-karte__preis--rot', gruen);
        preis?.classList.toggle('zone-karte__preis--gruen', !gruen);
        n++;
      }
    };

    const wendeSofortAn = () => {
      leerAnimation?.cancel();
      leerAnimation = undefined;
      for (const e of karten) e.karte.hidden = !e.passt;
      faerbeNachReihenfolge();
      leerBox.hidden = !leerSoll;
    };

    const wendeAn = async () => {
      const meine = ++generation;
      const vorher = merke();
      stoppeAnimationen();
      // laufende Bewegungen sauber übernehmen (kein Springen bei schnellem Tippen)
      bewegeVon(vorher);

      const ausblenden = karten.filter((e) => !e.karte.hidden && !e.passt).map((e) => e.karte);
      const einblenden = karten.filter((e) => e.karte.hidden && e.passt).map((e) => e.karte);

      if (!leerSoll) verbergeLeerBox();

      if (ausblenden.length > 0) {
        const aus = ausblenden.map((karte) =>
          starte(
            karte,
            [{ opacity: vorher.deckkraft.get(karte) ?? 1, transform: NORMAL.transform }, VERSTECKT],
            { duration: DAUER_AUS, easing: 'ease-in', fill: 'forwards' },
          ),
        );
        await Promise.allSettled(aus.map((a) => a.finished));
        if (meine !== generation) return;
      }

      const davor = merke();
      stoppeAnimationen();
      for (const e of karten) e.karte.hidden = !e.passt;
      faerbeNachReihenfolge();
      if (leerSoll) zeigeLeerBox();
      bewegeVon(davor, einblenden);
    };

    const filterZonen = (sofortStatus = false) => {
      const rohWert = eingabe.value.trim();
      const anfragen = erzeugeAnfrageVarianten(rohWert);
      const hatSuche = anfragen.length > 0;

      if (leerenBtn) {
        leerenBtn.hidden = eingabe.value.length === 0;
      }

      let sichtbareAnzahl = 0;

      for (const eintrag of karten) {
        if (!hatSuche) {
          eintrag.passt = true;
          sichtbareAnzahl++;
          for (const ortEintrag of eintrag.orte) {
            setzeOrtHervorhebung(ortEintrag.el, ortEintrag.ort, null);
          }
          continue;
        }

        let zonePasst = false;
        for (const ortEintrag of eintrag.orte) {
          const bereich = berechneTrefferBereich(ortEintrag.ort, anfragen);
          if (bereich) {
            zonePasst = true;
          }
          setzeOrtHervorhebung(ortEintrag.el, ortEintrag.ort, bereich);
        }

        eintrag.passt = zonePasst;
        if (zonePasst) sichtbareAnzahl++;
      }

      leerSoll = hatSuche && sichtbareAnzahl === 0;
      window.clearTimeout(animationsTimer);
      if (reduzierteBewegung()) {
        generation++;
        stoppeAnimationen();
        wendeSofortAn();
      } else {
        animationsTimer = window.setTimeout(wendeAn, sofortStatus ? 0 : 60);
      }
      meldeStatus(sichtbareAnzahl, hatSuche, sofortStatus);
    };

    eingabe.addEventListener('input', () => filterZonen(false));

    eingabe.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && eingabe.value.length > 0) {
        event.preventDefault();
        eingabe.value = '';
        filterZonen(true);
      }
    });

    leerenBtn?.addEventListener('click', () => {
      eingabe.value = '';
      filterZonen(true);
      eingabe.focus();
    });
  }
</script>

<style>
  .lieferkosten {
    padding-top: var(--abstand-l);
    margin-top: calc(var(--abstand-sektion) - var(--abstand-l));
    /* Deko-Auto darf nicht seitlich aus dem Bildschirm ragen (kein horizontales Scrollen) */
    overflow-x: clip;
    /* Platz unter dem Raster, damit das überstehende Auto nicht in den nächsten Abschnitt ragt */
    padding-bottom: var(--abstand-xl);
  }

  .lieferkosten__kopf {
    text-align: left;
    margin-bottom: var(--abstand-xl);
  }

  .lieferkosten__untertitel {
    margin-top: var(--abstand-m);
    margin-inline: 0;
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
  }

  @media (min-width: 1024px) {
    .lieferkosten__untertitel {
      font-size: var(--text-l);
    }
  }

  /* Suchfeld: rote Pill, mind. 44px hoch, >= 16px Schrift gegen iOS-Zoom */
  .lieferkosten__suche {
    position: relative;
    margin-bottom: var(--abstand-l);
  }

  .lieferkosten__lupe {
    position: absolute;
    left: var(--abstand-m);
    top: 50%;
    transform: translateY(-50%);
    width: 1.375rem;
    height: 1.375rem;
    object-fit: contain;
    pointer-events: none;
  }

  .lieferkosten__eingabe {
    width: 100%;
    min-height: 44px;
    height: 3rem;
    padding-block: var(--abstand-xs);
    padding-inline: 3.25rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--farbe-rot);
    color: var(--farbe-text-hell);
    font-family: var(--schrift-basis);
    font-size: max(1rem, var(--text-basis));
    font-weight: var(--gewicht-fett);
    line-height: 1.3;
    box-shadow: var(--schatten-klein);
  }

  .lieferkosten__eingabe::placeholder {
    color: color-mix(in srgb, var(--farbe-offwhite) 80%, transparent);
    font-weight: var(--gewicht-normal);
  }

  .lieferkosten__eingabe::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .lieferkosten__leeren {
    position: absolute;
    right: var(--abstand-2xs);
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--farbe-text-hell);
    font-size: 1.375rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .lieferkosten__leeren[hidden] {
    display: none;
  }

  /* Zonen-Raster: mobil kompakte Liste, ab Tablet 2 Spalten */
  /* Wrapper für Zonen-Raster + Deko-Auto */
  .lieferkosten__zonen {
    position: relative;
  }

  .lieferkosten__auto {
    display: none;
  }

  @media (min-width: 1024px) {
    .lieferkosten__auto {
      --auto-w: clamp(280px, 24vw, 440px);
      display: block;
      position: absolute;
      z-index: 2;
      width: var(--auto-w);
      /* überlappt nur die linke untere Ecke der letzten Karte (Figma) */
      /* (100vw - 100%) / 2 = freier Rand links neben dem Raster; nie über den Bildschirmrand hinaus */
      left: max(calc(var(--auto-w) * -0.68), calc((100vw - 100%) / -2 + 1rem));
      bottom: calc(var(--auto-w) * -0.3);
      pointer-events: none;
    }

    .lieferkosten {
      padding-bottom: clamp(6rem, 9vw, 9rem);
    }

    .lieferkosten__auto {
      transition: opacity 200ms ease-out;
    }

    /* Ohne Treffer gibt es kein Raster – das Auto blendet dann aus */
    .lieferkosten:has(.lieferkosten__leer:not([hidden])) .lieferkosten__auto {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .lieferkosten__auto {
        transition: none;
      }
    }

    .lieferkosten__auto-bild {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Auto nur, wenn links neben dem Raster genug Platz ist – sonst würde es Text verdecken */
    @media (max-width: 1599px) {
      .lieferkosten__auto {
        display: none;
      }
    }
  }

  .lieferkosten__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abstand-m);
  }

  @media (min-width: 768px) {
    .lieferkosten__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--abstand-l);
    }
  }

  .lieferkosten__grid :global(.zone-karte) {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    align-items: center;
    column-gap: var(--abstand-m);
    row-gap: var(--abstand-2xs);
    /* Mobil: kleine Karte -> großzügiger Innenabstand (20px) und weniger runde innere Elemente (14px).
       Konzentrisch bleibt es trotzdem: Kartenradius = 20 + 14 = 34px. So bleibt Abstand zwischen Text und Rundung. */
    --karte-innen: 1.25rem;
    --radius-innen: 14px;
    padding: var(--karte-innen);
  }

  .lieferkosten__grid :global(.zone-karte[hidden]) {
    display: none;
  }

  .zone-karte__titel {
    grid-column: 1;
    grid-row: 1;
    font-size: var(--text-l);
    font-weight: var(--gewicht-fett);
    line-height: var(--zeilenhoehe-eng);
  }

  .zone-karte__orte {
    grid-column: 1;
    grid-row: 2;
    max-width: none;
    font-size: var(--text-s);
    line-height: var(--zeilenhoehe);
  }

  /* Farbwechsel, wenn eine Karte bei der Suche die Spalte wechselt */
  .lieferkosten__grid :global(.zone-karte),

---
// Abschnitt "Öffnungszeiten & Kontakt" mit Live-Status-Badge und Kontaktdaten
import Button from '../Button.astro';
import Karte from '../Karte.astro';
import { gruppiereOeffnungszeiten } from '../../scripts/oeffnungsstatus';
import kontakt from '../../content/kontakt.json';
import oeffnungszeiten from '../../content/oeffnungszeiten.json';
import texte from '../../content/texte.json';

const { offeneGruppen, ruhetage } = gruppiereOeffnungszeiten(oeffnungszeiten.tage);
const oeffnungsTexte = texte.oeffnungszeitenKontakt;
const statusTexte = texte.oeffnungsstatus;
---

<section class="ok" aria-labelledby="oeffnungszeiten-kontakt-titel">
  <div class="ok__kopf">
    <div class="container">
      <h2 id="oeffnungszeiten-kontakt-titel" class="sektion-titel">
        {oeffnungsTexte.ueberschrift}
      </h2>
    </div>
  </div>

  <div class="container">
    <div class="ok__grid">
      <!-- Rote Karte: Unsere Öffnungszeiten -->
      <Karte id="oeffnungszeiten" farbe="rot" schatten class="ok-karte">
        <div
          class="status-badge"
          hidden
          data-oeffnungsstatus
          data-jetzt-geoeffnet={statusTexte.jetztGeoeffnet}
          data-oeffnet-heute={statusTexte.oeffnetHeute}
          data-oeffnet-tag={statusTexte.oeffnetTag}
          data-geschlossen-hinweis={statusTexte.geschlossenMitHinweis}
          data-geschlossen={statusTexte.geschlossen}
          data-derzeit-geschlossen={statusTexte.derzeitGeschlossen}
          role="status"
          aria-live="polite"
        >
          <span class="status-badge__punkt" aria-hidden="true"></span>
          <span class="status-badge__text" data-status-text></span>
        </div>

        <h3 class="ok-karte__titel">{oeffnungsTexte.oeffnungszeitenTitel}</h3>

        <dl class="zeiten-liste">
          {offeneGruppen.map((gruppe) => {
            const label =
              gruppe.von === gruppe.bis ? gruppe.von : `${gruppe.von} – ${gruppe.bis}`;
            return (
              <div class="zeiten-liste__gruppe">
                <dt class="zeiten-liste__tage">{label}</dt>
                {gruppe.zeiten.map((spanne) => (
                  <dd class="zeiten-liste__zeit">
                    {oeffnungsTexte.zeitspanne
                      .replace('{von}', spanne.von)
                      .replace('{bis}', spanne.bis)}
                  </dd>
                ))}
              </div>
            );
          })}

          {ruhetage.length > 0 && (
            <div class="zeiten-liste__ruhetag">
              <dt class="zeiten-liste__ruhe-label">{ruhetage.join(', ')}:</dt>
              <dd class="zeiten-liste__ruhe-wert">{oeffnungsTexte.geschlossenLabel}</dd>
            </div>
          )}
        </dl>
      </Karte>

      <!-- Grüne Karte: So erreichen Sie uns -->
      <Karte id="kontakt" farbe="gruen" schatten class="ok-karte">
        <h3 class="ok-karte__titel">{oeffnungsTexte.kontaktTitel}</h3>

        <address class="kontakt-daten">
          <p class="kontakt-daten__adresse">
            <strong class="kontakt-daten__name">{kontakt.name}</strong>
            <br />
            {kontakt.adresse.strasse},
            <br />
            {kontakt.adresse.plz} {kontakt.adresse.ort}
          </p>

          <ul class="kontakt-daten__liste">
            <li>
              {oeffnungsTexte.labelTelefon}{' '}
              <a href={kontakt.telefon.link} class="kontakt-daten__wert">
                {kontakt.telefon.anzeige}
              </a>
            </li>
            <li>
              {oeffnungsTexte.labelWhatsapp}{' '}
              <a
                href={kontakt.whatsapp.link}
                class="kontakt-daten__wert"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${oeffnungsTexte.whatsappAriaLabel}: ${kontakt.whatsapp.anzeige}`}
              >
                {kontakt.whatsapp.anzeige}
              </a>
            </li>
            <li>
              {oeffnungsTexte.labelEmail}{' '}
              {kontakt.email.verlinken ? (
                <a href={`mailto:${kontakt.email.adresse}`} class="kontakt-daten__wert">
                  {kontakt.email.adresse}
                </a>
              ) : (
                <strong class="kontakt-daten__wert">{kontakt.email.adresse}</strong>
              )}
            </li>
          </ul>
        </address>

        <div class="kontakt-daten__aktion">
          <Button
            href={kontakt.karte.google}
            variante="rot"
            groesse="klein"
            icon="pin"
            extern
            ariaLabel={oeffnungsTexte.karteAriaLabel}
          >
            {oeffnungsTexte.karteButton}
          </Button>
        </div>
      </Karte>
    </div>
  </div>
</section>

<script>
  import oeffnungszeiten from '../../content/oeffnungszeiten.json';
  import {
    ermittleOeffnungsstatus,
    type OeffnungsstatusTexte,
  } from '../../scripts/oeffnungsstatus';

  const badge = document.querySelector<HTMLElement>('[data-oeffnungsstatus]');
  const textEl = badge?.querySelector<HTMLElement>('[data-status-text]');

  if (badge && textEl) {
    const statusTexte: OeffnungsstatusTexte = {
      jetztGeoeffnet: badge.dataset.jetztGeoeffnet ?? '',
      oeffnetHeute: badge.dataset.oeffnetHeute ?? '',
      oeffnetTag: badge.dataset.oeffnetTag ?? '',
      geschlossenMitHinweis: badge.dataset.geschlossenHinweis ?? '',
      geschlossen: badge.dataset.geschlossen ?? '',
      derzeitGeschlossen: badge.dataset.derzeitGeschlossen ?? '',
    };

    const aktualisiere = () => {
      const status = ermittleOeffnungsstatus(new Date(), oeffnungszeiten, statusTexte);
      badge.classList.toggle('status-badge--offen', status.offen);
      textEl.textContent = status.text;
      badge.hidden = false;
    };

    aktualisiere();
    window.setInterval(aktualisiere, 60_000);
  }
</script>

<style>
  .ok {
    position: relative;
    overflow-x: clip;
    padding-top: var(--abstand-l);
    margin-top: calc(var(--abstand-sektion) - var(--abstand-l));
    padding-bottom: var(--abstand-sektion);
  }

  @media (min-width: 1024px) {
    .ok {
      margin-top: calc(var(--abstand-sektion) + 1rem);
    }
  }

  .ok__kopf {
    position: relative;
    padding-bottom: var(--abstand-xl);
  }

  .ok__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abstand-m);
  }

  @media (min-width: 768px) {
    .ok__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--abstand-l);
    }
  }

  .ok__grid :global(.ok-karte) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--abstand-m);
  }

  /* Live-Status-Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--abstand-xs);
    padding: var(--abstand-2xs) var(--abstand-s);
    border-radius: var(--radius-pill);
    background-color: var(--farbe-offwhite);
    color: var(--farbe-leiste-text);
    font-size: var(--text-xs);
    font-weight: var(--gewicht-fett);
    line-height: 1.3;
    box-shadow: var(--schatten-klein);
  }

  .status-badge[hidden] {
    display: none;
  }

  .status-badge__punkt {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--farbe-status-zu);
  }

  .status-badge--offen .status-badge__punkt {
    background-color: var(--farbe-gruen);
  }

  .ok-karte__titel {
    font-size: var(--text-xl);
    font-weight: var(--gewicht-fett);
    line-height: var(--zeilenhoehe-eng);
  }

  @media (min-width: 1024px) {
    .ok-karte__titel {
      font-size: var(--text-2xl);
    }
  }

  /* Öffnungszeiten-Liste */
  .zeiten-liste {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-m);
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
  }

  @media (min-width: 1024px) {
    .zeiten-liste {
      font-size: var(--text-l);
    }
  }

  .zeiten-liste__gruppe {
    display: flex;
    flex-direction: column;
  }

  .zeiten-liste__tage {
    font-weight: var(--gewicht-fett);
    margin-bottom: var(--abstand-xs);
  }

  .zeiten-liste__zeit {
    margin: 0;
  }

  .zeiten-liste__ruhetag {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-2xs);
    font-weight: var(--gewicht-fett);
  }

  .zeiten-liste__ruhe-wert {
    margin: 0;
  }

  /* Kontaktdaten */
  .kontakt-daten {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-m);
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
  }

  @media (min-width: 1024px) {
    .kontakt-daten {
      font-size: var(--text-l);
    }
  }

  .kontakt-daten__name {
    font-size: 1.1em;
    font-weight: var(--gewicht-fett);
  }

  .kontakt-daten__liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-2xs);
  }

  .kontakt-daten__wert {
    font-weight: var(--gewicht-fett);
  }

  @media (pointer: coarse) {
    .kontakt-daten__liste a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  .kontakt-daten__aktion {
    margin-top: auto;
    padding-top: var(--abstand-xs);
  }
</style>

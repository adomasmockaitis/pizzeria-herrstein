---
// Abschnitt "Frisch aus unserer Küche" mit 5 Kategorie-Karten als Scroll-Kartenstapel
// (Desktop >= 1024px sowie Mobil/Tablet < 1024px) bzw. ruhiger Kartenliste (reduced motion, ohne JS)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AbschnittTitel from '../AbschnittTitel.astro';
import Button from '../Button.astro';
import Karte from '../Karte.astro';
import texte from '../../content/texte.json';
import kategorieFarbenRoh from '../../content/kategorie-farben.json';

type KategorieFarbe = 'gruen' | 'rot';

interface GenussKategorie {
  titel: string;
  text: string;
  button: string;
  anker: string;
  bild: string;
}

const kategorieFarben = kategorieFarbenRoh as Record<string, KategorieFarbe>;
const farbeFuerKategorie = (id: string, index: number): KategorieFarbe =>
  kategorieFarben[id] ?? (index % 2 === 0 ? 'gruen' : 'rot');

const bilder = import.meta.glob<{ default: ImageMetadata }>('../../assets/fotos/*.{webp,jpg,png}', {
  eager: true,
});

const fallbackBild = 'pizza-rand-inna-gurina.webp';

const findeBild = (dateiname: string) => {
  const direkt = bilder[`../../assets/fotos/${dateiname}`]?.default;
  if (direkt) {
    return { dateiname, src: direkt };
  }
  const fallback = bilder[`../../assets/fotos/${fallbackBild}`]?.default;
  return fallback ? { dateiname: fallbackBild, src: fallback } : null;
};

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const kategorien = (texte.genuss.kategorien as GenussKategorie[]).map((kat, index) => {
  const aufgeloest = findeBild(kat.bild);
  const kategorieId = kat.anker.replace(/^#/, '');
  return {
    ...kat,
    farbe: farbeFuerKategorie(kategorieId, index),
    bildDateiname: aufgeloest?.dateiname ?? fallbackBild,
    bildSrc: aufgeloest?.src ?? null,
  };
});

const bildEbenen = Array.from(
  new Map(
    kategorien
      .filter((kat): kat is typeof kat & { bildSrc: ImageMetadata } => kat.bildSrc !== null)
      .map((kat) => [kat.bildDateiname, kat.bildSrc]),
  ).entries(),
).map(([dateiname, src]) => ({
  dateiname,
  src,
  istPizzaAusschnitt: dateiname === fallbackBild,
}));

const startBild = kategorien[0]?.bildDateiname ?? fallbackBild;
const drehungenDesktop = [-2, 1.5, -1.5, 2, -1];
const drehungenMobil = [-1, 1, -1, 1, -1];
---

<section class="genuss" id="genuss" aria-labelledby="genuss-titel" data-genuss>
  <div class="genuss__buehne" data-genuss-buehne>
    <div class="container genuss__grid">
      <div class="genuss__intro" data-einblenden>
        <AbschnittTitel id="genuss-titel" farbe="rot" class="genuss__titel">
          {texte.genuss.ueberschrift}
        </AbschnittTitel>
        <p class="genuss__text">{texte.genuss.text}</p>
        <div class="genuss__aktion">
          <Button href={`${base}speisekarte/`} variante="rot" groesse="klein">
            {texte.genuss.button}
          </Button>
        </div>
      </div>

      <!-- Rundes Deko-Bild: mobil/tablet kompakt rechts neben dem Intro, Desktop groß am linken Rand -->
      <div class="genuss__gericht" aria-hidden="true" data-genuss-gericht data-bild={startBild}>
        <div class="genuss__gericht-drehung" data-genuss-drehung>
          {bildEbenen.map((ebene) => (
            <div
              class:list={['genuss__gericht-ebene', { 'ist-aktiv': ebene.dateiname === startBild }]}
              data-genuss-ebene={ebene.dateiname}
            >
              <Image
                src={ebene.src}
                alt=""
                widths={[160, 320, 420, 620, 960]}
                sizes="(min-width: 1024px) 620px, 150px"
                loading="lazy"
                class:list={[
                  'genuss__gericht-bild',
                  { 'genuss__gericht-bild--pizza': ebene.istPizzaAusschnitt },
                ]}
              />
            </div>
          ))}
        </div>
      </div>

      <ul class="genuss__stapel" data-genuss-stapel>
        {kategorien.map((kat, index) => {
          const buttonVariante = kat.farbe === 'gruen' ? 'rot' : 'gruen';
          const drehung = drehungenDesktop[index] ?? 0;
          const drehungMobil = drehungenMobil[index] ?? 0;

          return (
            <li
              class:list={['genuss__stapel-eintrag', { 'ist-aktiv': index === 0 }]}
              style={`--karte-index: ${index}; --karte-drehung: ${drehung}deg; --karte-drehung-mobil: ${drehungMobil}deg;`}
              data-genuss-karte={index}
              data-drehung={drehung}
              data-drehung-mobil={drehungMobil}
              data-bild={kat.bildDateiname}
            >
              <Karte farbe={kat.farbe} schatten class="genuss__karte">
                <h3 class="genuss__karte-titel">{kat.titel}</h3>
                <p class="genuss__karte-text">{kat.text}</p>
                <div class="genuss__karte-aktion">
                  <Button
                    href={`${base}speisekarte/${kat.anker}`}
                    variante={buttonVariante}
                    groesse="klein"
                  >
                    {kat.button}
                  </Button>
                </div>
              </Karte>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<script>
  const sektion = document.querySelector<HTMLElement>('[data-genuss]');
  const buehne = sektion?.querySelector<HTMLElement>('[data-genuss-buehne]');
  const gericht = sektion?.querySelector<HTMLElement>('[data-genuss-gericht]');
  const drehungEl = sektion?.querySelector<HTMLElement>('[data-genuss-drehung]');
  const stapel = sektion?.querySelector<HTMLElement>('[data-genuss-stapel]');

  if (sektion && buehne && stapel) {
    const bildEbenen = Array.from(
      gericht?.querySelectorAll<HTMLElement>('[data-genuss-ebene]') ?? [],
    );

    const karten = Array.from(stapel.querySelectorAll<HTMLElement>('[data-genuss-karte]')).map(
      (el, index) => ({
        el,
        index,
        drehungDesktop: Number(el.dataset.drehung ?? 0),
        drehungMobil: Number(el.dataset.drehungMobil ?? 0),
        bild: el.dataset.bild ?? '',
      }),
    );

    const anzahl = karten.length;
    const uebergaenge = Math.max(1, anzahl - 1);
    const startPuffer = 0.04;
    const endPuffer = 0.08;
    const bereichSpanne = (1 - startPuffer - endPuffer) / uebergaenge;

    interface StapelKonfig {
      stapelVersatzPx: number;
      bildDrehungGrad: number;
      istDesktop: boolean;
    }

    const desktopMedia = window.matchMedia('(min-width: 1024px)');
    const tabletMedia = window.matchMedia('(min-width: 768px)');
    const kurzHoeheMedia = window.matchMedia('(max-height: 639px)');
    const reduziertMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (wert: number, min: number, max: number) => Math.min(max, Math.max(min, wert));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    const istStapelAktiv = () => !reduziertMedia.matches;

    const holeKonfig = (): StapelKonfig =>
      desktopMedia.matches
        ? { stapelVersatzPx: 14, bildDrehungGrad: 60, istDesktop: true }
        : { stapelVersatzPx: 10, bildDrehungGrad: 30, istDesktop: false };

    let letztesBild = gericht?.dataset.bild ?? karten[0]?.bild ?? '';
    let rahmenId: number | null = null;
    let fallbackTimer: number | null = null;

    const brichGeplanteUpdatesAb = () => {
      if (rahmenId !== null) {
        window.cancelAnimationFrame(rahmenId);
        rahmenId = null;
      }
      if (fallbackTimer !== null) {
        window.clearTimeout(fallbackTimer);
        fallbackTimer = null;
      }
    };

    const setzeAktivesBild = (dateiname: string) => {
      if (!gericht || !dateiname) return;
      letztesBild = dateiname;
      gericht.dataset.bild = dateiname;
      for (const ebene of bildEbenen) {
        ebene.classList.toggle('ist-aktiv', ebene.dataset.genussEbene === dateiname);
      }
    };

    const berechneStickyMetrik = () => {
      const rect = sektion.getBoundingClientRect();
      const buehneRect = buehne.getBoundingClientRect();
      const stapelRect = stapel.getBoundingClientRect();
      const stickyTop = Number.parseFloat(window.getComputedStyle(buehne).top) || 0;
      // Exakte Sticky-Wegstrecke: Sektionshöhe minus tatsächliche Bühnenhöhe (inkl. Header/Aktionsleiste/svh)
      const scrollDistanz = Math.max(1, rect.height - buehneRect.height);
      const abstandNachUnten = Math.max(stapelRect.height, buehneRect.bottom - stapelRect.top);
      return { rect, stickyTop, scrollDistanz, abstandNachUnten };
    };

    const aktualisiereStapel = () => {
      if (!istStapelAktiv()) return;

      const konfig = holeKonfig();
      const { rect, stickyTop, scrollDistanz, abstandNachUnten } = berechneStickyMetrik();
      const progress = clamp((stickyTop - rect.top) / scrollDistanz, 0, 1);
      const wegstreckeUnten = abstandNachUnten * 1.1;

      if (drehungEl) {
        drehungEl.style.transform = `rotate(${(progress * konfig.bildDrehungGrad).toFixed(2)}deg)`;
      }

      const ankuenfte: number[] = [];
      let aktivIndex = 0;

      for (let i = 0; i < anzahl; i++) {
        if (i === 0) {
          ankuenfte.push(1);
          continue;
        }
        const segmentStart = startPuffer + (i - 1) * bereichSpanne;
        const roh = clamp((progress - segmentStart) / bereichSpanne, 0, 1);
        const ankunft = easeOutCubic(roh);
        ankuenfte.push(ankunft);
        if (roh >= 0.5) {
          aktivIndex = i;
        }
      }

      for (let i = 0; i < anzahl; i++) {
        const eintrag = karten[i];
        const ankunft = ankuenfte[i];
        const naechsteAnkunft = i < anzahl - 1 ? ankuenfte[i + 1] : 0;
        const zielY = i * konfig.stapelVersatzPx;
        const yPx = zielY + (1 - ankunft) * wegstreckeUnten;
        const scale = 1 - 0.04 * naechsteAnkunft;
        const drehung = konfig.istDesktop ? eintrag.drehungDesktop : eintrag.drehungMobil;

        eintrag.el.style.transform = `translate3d(0, ${yPx.toFixed(1)}px, 0) rotate(${drehung}deg) scale(${scale.toFixed(4)})`;
        eintrag.el.classList.toggle('ist-aktiv', i === aktivIndex);
        eintrag.el.classList.toggle('ist-darunter', i < aktivIndex);
      }

      const aktivesBild = karten[aktivIndex]?.bild ?? karten[0]?.bild ?? '';
      if (aktivesBild && aktivesBild !== letztesBild) {
        setzeAktivesBild(aktivesBild);
      }
    };

    const fuehreUpdateAus = () => {
      brichGeplanteUpdatesAb();
      aktualisiereStapel();
    };

    const planeUpdate = () => {
      if (!istStapelAktiv()) return;
      // Direkter Fallback, falls rAF nicht läuft (z. B. Hintergrund-Tab oder kein rAF verfügbar)
      if (document.hidden || typeof window.requestAnimationFrame !== 'function') {
        fuehreUpdateAus();
        return;
      }
      if (rahmenId !== null) return;
      rahmenId = window.requestAnimationFrame(fuehreUpdateAus);
      // Sicherheitsnetz, falls rAF gedrosselt oder pausiert wird
      fallbackTimer = window.setTimeout(fuehreUpdateAus, 120);
    };

    const setzeZustandZurueck = () => {
      brichGeplanteUpdatesAb();
      if (drehungEl) {
        drehungEl.style.transform = '';
      }
      for (const eintrag of karten) {
        eintrag.el.style.transform = '';
        eintrag.el.classList.remove('ist-darunter', 'ist-aktiv');
      }
    };

    const initialisiereModus = () => {
      setzeZustandZurueck();

      if (istStapelAktiv()) {
        aktualisiereStapel();
      }
    };

    // Tastatur-Barrierefreiheit: Fokus auf Button in einer Stapel-Karte scrollt sie ins Bild
    stapel.addEventListener('focusin', (event) => {
      if (!istStapelAktiv()) return;
      const zielEl = event.target instanceof HTMLElement ? event.target : null;
      const kartenEl = zielEl?.closest<HTMLElement>('[data-genuss-karte]');
      if (!kartenEl) return;

      const index = Number(kartenEl.dataset.genussKarte ?? 0);
      const zielProgress = index === 0 ? 0 : startPuffer + index * bereichSpanne;
      const { rect, stickyTop, scrollDistanz } = berechneStickyMetrik();
      const sektionOben = rect.top + window.scrollY;
      const zielScrollY = sektionOben - stickyTop + zielProgress * scrollDistanz;

      window.scrollTo({ top: Math.max(0, Math.round(zielScrollY)), behavior: 'auto' });
      fuehreUpdateAus();
    });

    window.addEventListener('scroll', planeUpdate, { passive: true });
    window.addEventListener('resize', planeUpdate, { passive: true });
    window.addEventListener('orientationchange', initialisiereModus, { passive: true });
    window.addEventListener('pageshow', fuehreUpdateAus);
    window.addEventListener('pagereveal', fuehreUpdateAus);
    desktopMedia.addEventListener('change', initialisiereModus);
    tabletMedia.addEventListener('change', initialisiereModus);
    kurzHoeheMedia.addEventListener('change', initialisiereModus);
    reduziertMedia.addEventListener('change', initialisiereModus);

    initialisiereModus();
  }
</script>

<style>
  /* position: relative + z-index: 2 liegt sauber über dem 160px-Verlauf des Hero;
     margin-top >= 160px stellt sicher, dass der Inhalt erst auf voll deckendem Offwhite beginnt. */
  .genuss {
    position: relative;
    z-index: 2;
    margin-top: max(10rem, var(--abstand-sektion));
    padding-top: var(--abstand-l);
  }

  .genuss__buehne {
    position: relative;
    overflow-x: clip;
  }

  /* Deko-Bild im Basis-/Listenmodus (ohne JS oder reduced motion) ausgeblendet */
  .genuss__gericht {
    display: none;
  }

  .genuss__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abstand-xl);
    align-items: center;
  }

  .genuss__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--abstand-m);
  }

  .genuss__text {
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
  }

  .genuss__aktion {
    margin-top: var(--abstand-xs);
  }

  /* Kartenliste (Fallback bei reduced motion und ohne JS): untereinander mit 16px Abstand */
  .genuss__stapel {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-m);
    padding-block: var(--abstand-xs);
  }

  .genuss__stapel-eintrag {
    transform: rotate(var(--karte-drehung-mobil, 0deg));
  }

  .genuss__stapel-eintrag :global(.genuss__karte) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-m);
    cursor: pointer;
  }

  /* Gesamte Karte über den Button-Link antippbar (erhält Fokus & Morph-Selektor).
     Kein transform auf :active, damit ::after beim Antippen nicht vom Button eingefangen wird. */
  .genuss__karte-aktion :global(.btn)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
  }

  .genuss__karte-aktion :global(.btn):active {
    transform: none;
    opacity: 0.85;
  }

  .genuss__karte-titel {
    font-size: var(--text-xl);
    font-weight: var(--gewicht-fett);
    line-height: var(--zeilenhoehe-eng);
  }

  .genuss__karte-text {
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
  }

  .genuss__karte-aktion {
    margin-top: auto;
    padding-top: var(--abstand-xs);
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .genuss__text {
      font-size: var(--text-l);
    }

    .genuss__karte-titel {
      font-size: var(--text-2xl);
    }

    .genuss__karte-text {
      font-size: var(--text-l);
    }
  }

  /* ---------- Sticky-Scroll-Kartenstapel (alle Breakpoints mit JS, ohne reduced motion) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .genuss {
      padding-top: 0;
      height: calc(100vh + 5 * 45vh);
      height: calc(100svh + 5 * 45svh);
    }

    :global(html.js) .genuss__buehne {
      --buehne-unten: calc(
        var(--aktionsleiste-hoehe, 64px) + 2 * var(--aktionsleiste-abstand, 12px) +
          env(safe-area-inset-bottom, 0px)
      );
      position: sticky;
      top: var(--aktuelle-leiste-hoehe);
      height: calc(100vh - var(--aktuelle-leiste-hoehe) - var(--buehne-unten));
      height: calc(100svh - var(--aktuelle-leiste-hoehe) - var(--buehne-unten));
      display: flex;
      align-items: stretch;
      overflow: hidden;
      overflow: clip;
    }

    :global(html.js) .genuss__gericht-drehung {
      position: relative;
      width: 100%;
      height: 100%;
      will-change: transform;
    }

    :global(html.js) .genuss__gericht-ebene {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      overflow: hidden;
      opacity: 0;
      transform: rotate(-10deg) scale(0.96);
      transition:
        opacity 400ms ease,
        transform 400ms ease;
    }

    :global(html.js) .genuss__gericht-ebene.ist-aktiv {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }

    :global(html.js) .genuss__gericht-bild {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    :global(html.js) .genuss__gericht-bild--pizza {
      position: absolute;
      max-width: none;
      width: 179.27%;
      height: 115.99%;
      left: -19.82%;
      top: -10.66%;
    }

    /* Kartenstapel: alle 5 Karten absolut übereinander, nur aktive Karte antippbar */
    :global(html.js) .genuss__stapel {
      position: relative;
      display: block;
      width: 100%;
      padding-block: 0;
    }

    :global(html.js) .genuss__stapel-eintrag {
      position: absolute;
      inset-inline: 0;
      top: 0;
      z-index: calc(var(--karte-index) + 1);
      transform-origin: center top;
      pointer-events: none;
      will-change: transform;
    }

    :global(html.js) .genuss__stapel-eintrag.ist-aktiv {
      pointer-events: auto;
    }

    /* Abdunkeln älterer Karten ausschließlich über opacity (GPU-Compositor, ohne filter) */
    :global(html.js) .genuss__stapel-eintrag :global(.genuss__karte)::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: rgba(0, 0, 0, 0.14);
      opacity: 0;
      pointer-events: none;
      z-index: 2;
      transition: opacity 250ms ease;
    }

    :global(html.js) .genuss__stapel-eintrag.ist-darunter :global(.genuss__karte)::after {
      opacity: 1;
    }
  }

  /* ---------- Mobil & Tablet (< 1024px): vertikale Sticky-Bühne ---------- */
  @media (max-width: 1023.98px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .genuss__grid {
      height: 100%;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: var(--abstand-s);
      row-gap: var(--abstand-m);
      padding-block: var(--abstand-s) var(--abstand-m);
      align-items: center;
    }

    :global(html.js) .genuss__intro {
      grid-column: 1;
      grid-row: 1;
      gap: var(--abstand-xs);
    }

    :global(html.js) .genuss__titel {
      font-size: clamp(1.4375rem, 1.2rem + 1.1vw, 1.875rem);
    }

    /* Auf max. 3 Zeilen gekürzt; vollständiger Text bleibt für Screenreader im DOM */
    :global(html.js) .genuss__text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
    }

    /* Mobil ein klarer Haupt-CTA pro Karte (HIG), keine Überschneidung mit dem Stapel */
    :global(html.js) .genuss__aktion {
      display: none;
    }

    /* Kompaktes rundes Deko-Bild rechts neben Titel und Intro-Text (ohne Überlappung) */
    :global(html.js) .genuss__gericht {
      display: block;
      grid-column: 2;
      grid-row: 1;
      position: relative;
      width: clamp(120px, 24vw, 150px);
      aspect-ratio: 1 / 1;
      align-self: center;
      pointer-events: none;
    }

    :global(html.js) .genuss__stapel {
      grid-column: 1 / -1;
      grid-row: 2;
      height: min(100%, 24.5rem);
      align-self: center;
    }

    :global(html.js) .genuss__stapel-eintrag {
      height: min(calc(100% - 44px), 21rem);
      transform: translate3d(0, 110vh, 0) rotate(var(--karte-drehung-mobil, 0deg));
      transform: translate3d(0, 110svh, 0) rotate(var(--karte-drehung-mobil, 0deg));
    }

    :global(html.js) .genuss__stapel-eintrag:first-child {
      transform: translate3d(0, 0, 0) rotate(var(--karte-drehung-mobil, 0deg));
    }

    /* Konzentrische Ecken: --karte-innen (20px) + --radius-innen (20px) = 40px Radius */
    :global(html.js) .genuss__stapel-eintrag :global(.genuss__karte) {
      --karte-innen: 1.25rem;
      min-height: 100%;
      gap: var(--abstand-s);
    }

    :global(html.js) .genuss__karte-titel {
      font-size: clamp(1.3125rem, 1.15rem + 0.6vw, 1.5rem);
    }
  }

  /* Tablet (768px–1023px): MobileAktionsleiste ist ausgeblendet, mehr Raum für Bühne & Karten */
  @media (min-width: 768px) and (max-width: 1023.98px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .genuss__buehne {
      --buehne-unten: env(safe-area-inset-bottom, 0px);
    }

    :global(html.js) .genuss__grid {
      column-gap: var(--abstand-l);
      row-gap: var(--abstand-l);
      padding-block: var(--abstand-m) var(--abstand-l);
    }

    :global(html.js) .genuss__stapel {
      height: min(100%, 26rem);
    }

    :global(html.js) .genuss__stapel-eintrag {

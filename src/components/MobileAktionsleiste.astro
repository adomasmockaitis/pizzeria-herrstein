---
// Schwebende Schnellkontakt-Leiste (iOS-Toolbar) am unteren Bildschirmrand (nur < 768px sichtbar)
import { Image } from 'astro:assets';
import kontakt from '../content/kontakt.json';
import texte from '../content/texte.json';
import telefonIcon from '../assets/icons/telefon.png';
import whatsappIcon from '../assets/icons/whatsapp.png';
---

<aside class="aktionsleiste" aria-label={texte.mobileLeiste.ariaLabel}>
  <a href={kontakt.telefon.link} class="aktionsleiste__btn aktionsleiste__btn--rot">
    <Image
      src={telefonIcon}
      alt=""
      width={20}
      height={20}
      loading="eager"
      class="aktionsleiste__icon"
      aria-hidden="true"
    />
    <span>{texte.mobileLeiste.anrufen}</span>
  </a>

  <a
    href={kontakt.whatsapp.link}
    class="aktionsleiste__btn aktionsleiste__btn--gruen"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={texte.mobileLeiste.whatsappAriaLabel}
  >
    <Image
      src={whatsappIcon}
      alt=""
      width={20}
      height={20}
      loading="eager"
      class="aktionsleiste__icon"
      aria-hidden="true"
    />
    <span>{texte.mobileLeiste.whatsapp}</span>
  </a>
</aside>

<style>
  /* Schwebende Leiste: 12px Abstand zu den Rändern, Material mit Unschärfe (Fallback: deckend) */
  .aktionsleiste {
    position: fixed;
    left: var(--aktionsleiste-abstand, 12px);
    right: var(--aktionsleiste-abstand, 12px);
    bottom: calc(var(--aktionsleiste-abstand, 12px) + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--abstand-xs);
    padding: var(--abstand-xs);
    /* Konzentrische Ecken (Apple HIG): äußerer Radius = Button-Radius (48px / 2) + Innenabstand.
       Ergibt eine Kapsel, deren Rundung parallel zu den Pill-Buttons verläuft. */
    border-radius: calc(48px / 2 + var(--abstand-xs));
    background-color: color-mix(in srgb, var(--farbe-offwhite) 80%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 200ms ease;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .aktionsleiste {
      background-color: var(--farbe-offwhite);
    }
  }

  /* Startseite: erst einblenden, wenn der Hero (mit "Jetzt bestellen") aus dem Bild ist.
     Ohne JS und auf Unterseiten (nach-hero von Anfang an) immer sichtbar. */
  :global(html.js.hat-hero:not(.nach-hero)) .aktionsleiste {
    opacity: 0;
    transform: translateY(16px);
    visibility: hidden;
    pointer-events: none;
  }

  .aktionsleiste__btn {
    /* feste Höhe, damit die Ecken konzentrisch zum Rahmen bleiben */
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--abstand-xs);
    padding: 0 var(--abstand-m);
    border-radius: calc(48px / 2);
    color: var(--farbe-text-hell);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: 1.0625rem;
    text-decoration: none;
    transition:
      background-color var(--dauer-kurz) ease,
      transform 100ms ease,
      opacity 100ms ease;
  }

  .aktionsleiste__btn--rot {
    background-color: var(--farbe-rot);
  }

  .aktionsleiste__btn--gruen {
    background-color: var(--farbe-gruen);
  }

  @media (hover: hover) {
    .aktionsleiste__btn--rot:hover {
      background-color: var(--farbe-rot-dunkel);
    }

    .aktionsleiste__btn--gruen:hover {
      background-color: var(--farbe-gruen-dunkel);
    }
  }

  .aktionsleiste__icon {
    flex-shrink: 0;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .aktionsleiste {
      transition: none;
    }
  }

  /* Ab Tablet (768px) ausblenden */
  @media (min-width: 768px) {
    .aktionsleiste {
      display: none;
    }
  }
</style>

---
// Farbige Inhaltskarte (rot oder grün) im Figma-Stil
interface Props {
  farbe?: 'rot' | 'gruen';
  as?: 'article' | 'section' | 'div';
  schatten?: boolean;
  id?: string;
  class?: string;
}

const {
  farbe = 'rot',
  as: Tag = 'article',
  schatten = false,
  id,
  class: className = '',
} = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'karte',
    `karte--${farbe}`,
    schatten && 'karte--schatten',
    'auf-rot',
    className,
  ]}
>
  <slot />
</Tag>

<style>
  /* Konzentrisch: Radius = Innenabstand + --radius-innen. Wer den Innenabstand ändern will,
     setzt --karte-innen (nicht padding), dann passt der Radius automatisch. */
  .karte {
    --karte-innen: var(--abstand-l);
    padding: var(--karte-innen);
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
    color: var(--farbe-text-hell);
  }

  @media (min-width: 768px) {
    .karte {
      --karte-innen: calc(var(--abstand-m) * 2);
    }
  }

  .karte--rot {
    background-color: var(--farbe-rot);
  }

  .karte--gruen {
    background-color: var(--farbe-gruen);
  }

  .karte--schatten {
    box-shadow: var(--schatten-karte);
  }

  /* Textlinks innerhalb der Karte bleiben hell und unterstrichen */
  .karte :global(a:not(.btn)) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

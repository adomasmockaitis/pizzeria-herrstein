---
// Responsiver Header: Desktop (>= 1024px) transparent über Hero (Figma) oder fest.
// Mobil (< 1024px) nach Apple HIG: "Large Title"-Muster (auf der Startseite zeigt der Hero das große Logo,
// erst nach dem Hero erscheint die kompakte Leiste), Menü als Vollbild-Sheet.
import { Image } from 'astro:assets';
import Button from './Button.astro';
import kontakt from '../content/kontakt.json';
import texte from '../content/texte.json';
import oeffnungszeiten from '../content/oeffnungszeiten.json';
import logoKleinDunkel from '../assets/logo/logo-klein-dunkel.svg';
import telefonIcon from '../assets/icons/telefon.png';
import whatsappIcon from '../assets/icons/whatsapp.png';

interface Props {
  transparent?: boolean;
  aktiv?: 'home' | 'speisekarte' | string;
  variante?: 'standard' | 'unterseite';
  unterseiteTitel?: string;
}

const {
  transparent = true,
  aktiv = '',
  variante = 'standard',
  unterseiteTitel = '',
} = Astro.props;

const anrufenAriaLabel = texte.speisekarte.anrufenAriaLabel.replace(
  '{telefon}',
  kontakt.telefon.anzeige,
);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const navZiele = [
  { key: 'home', href: base },
  { key: 'speisekarte', href: `${base}speisekarte` },
  { key: 'lieferservice', href: `${base}#lieferservice` },
  { key: 'oeffnungszeiten', href: `${base}#oeffnungszeiten` },
  { key: 'kontakt', href: `${base}#kontakt` },
];

const navPunkte = navZiele.map((ziel, index) => ({
  ...ziel,
  label: texte.navigation[index].label,
}));

const logoAlt = texte.header.logoAlt.replace('{name}', kontakt.name);

// Öffnungszeiten-Kurzinfo aus den Daten, z. B. "Di–So 11–14 & 17–22 Uhr · Mo Ruhetag"
const uhrzeit = (z: string) => {
  const [stunde, minute] = z.split(':');
  return minute === '00' ? String(Number(stunde)) : `${Number(stunde)}:${minute}`;
};

const zeitGruppen: { von: string; bis: string; text: string; letzterIndex: number }[] = [];
const ruhetage: string[] = [];
oeffnungszeiten.tage.forEach((tag, index) => {
  if (tag.ruhetag || tag.zeiten.length === 0) {
    ruhetage.push(tag.kuerzel);
    return;
  }
  const text = tag.zeiten.map((z) => `${uhrzeit(z.von)}–${uhrzeit(z.bis)}`).join(' & ');
  const letzte = zeitGruppen[zeitGruppen.length - 1];
  if (letzte && letzte.text === text && letzte.letzterIndex === index - 1) {
    letzte.bis = tag.kuerzel;
    letzte.letzterIndex = index;
  } else {
    zeitGruppen.push({ von: tag.kuerzel, bis: tag.kuerzel, text, letzterIndex: index });
  }
});

const kurzinfoTeile = zeitGruppen.map((g) => {
  const tage = g.von === g.bis ? g.von : `${g.von}–${g.bis}`;
  return texte.header.kurzinfoOffen.replace('{tage}', tage).replace('{zeiten}', g.text);
});
if (ruhetage.length > 0) {
  kurzinfoTeile.push(texte.header.kurzinfoRuhetag.replace('{tage}', ruhetage.join(' & ')));
}
const oeffnungszeitenKurz = kurzinfoTeile.join(' · ');
---

{variante === 'unterseite' ? (
  <header class="header header--fest header--unterseite">
    <div class="unterseite-leiste">
      <div class="container unterseite-leiste__innen">
        <a
          href={base}
          class="unterseite-leiste__zurueck"
          aria-label={texte.speisekarte.zurueckAriaLabel}
        >
          <svg
            class="unterseite-leiste__chevron"
            viewBox="0 0 16 16"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10.25 3.25 5.5 8l4.75 4.75"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{texte.speisekarte.zurueckStartseite}</span>
        </a>

        <span class="unterseite-leiste__titel" data-nav-titel aria-hidden="true">
          {unterseiteTitel}
        </span>

        <div class="unterseite-leiste__aktionen">
          <div class="unterseite-leiste__anruf-desktop">
            <Button
              href={kontakt.telefon.link}
              variante="rot"
              groesse="klein"
              icon="telefon"
              ariaLabel={anrufenAriaLabel}
            >
              {kontakt.telefon.anzeige}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </header>
) : (
<header class:list={['header', transparent ? 'header--transparent' : 'header--fest', 'auf-rot']}>
  <div class="header__leiste">
    <!-- Kleines dunkles Logo nur mobil (< 1024px) in der kompakten Leiste -->
    <a href={base} class="header__logo-link">
      <Image
        src={logoKleinDunkel}
        alt={logoAlt}
        class="header__logo"
        loading="eager"
      />
    </a>

    <!-- Hauptnavigation (nur Desktop; mobil übernimmt das Menü-Sheet) -->
    <nav id="hauptmenue" class="header__nav" aria-label={texte.header.navigationLabel}>
      <ul class="header__liste">
        {navPunkte.map((punkt) => {
          const istAktiv = aktiv === punkt.key;
          return (
            <li class="header__item">
              <a
                href={punkt.href}
                class:list={['header__link', istAktiv && 'header__link--aktiv']}
                aria-current={istAktiv ? 'page' : undefined}
              >
                {punkt.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Desktop: Roter Pill-Button rechts -->
    <div class="header__telefon-desktop">
      <Button
        href={kontakt.telefon.link}
        variante="rot"
        groesse="klein"
        icon="telefon"
      >
        {kontakt.telefon.anzeige}
      </Button>
    </div>

    <!-- Mobil: nur der Burger-Button (Anrufen liegt in der Aktionsleiste und im Menü) -->
    <div class="header__mobil-aktionen">
      <button
        type="button"
        class="header__burger"
        aria-expanded="false"
        aria-controls="menue-sheet"
        aria-label={texte.header.menueOeffnen}
        data-label-oeffnen={texte.header.menueOeffnen}
        data-label-schliessen={texte.header.menueSchliessen}
      >
        <span class="header__burger-linie" aria-hidden="true"></span>
        <span class="header__burger-linie" aria-hidden="true"></span>
        <span class="header__burger-linie" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobiles Menü als Vollbild-Sheet -->
  <div
    id="menue-sheet"
    class="menue-sheet"
    role="dialog"
    aria-modal="true"
    aria-label={texte.header.menueDialogLabel}
  >
    <div class="menue-sheet__kopf">
      <a href={base} class="menue-sheet__logo">
        <Image src={logoKleinDunkel} alt={logoAlt} class="menue-sheet__logo-bild" />
      </a>
      <button
        type="button"
        class="menue-sheet__zu"
        aria-label={texte.header.menueSchliessen}
      ></button>
    </div>

    <nav class="menue-sheet__nav" aria-label={texte.header.navigationLabel}>
      <ul class="menue-sheet__liste">
        {navPunkte.map((punkt) => {
          const istAktiv = aktiv === punkt.key;
          return (
            <li>
              <a
                href={punkt.href}
                class:list={['menue-link', istAktiv && 'menue-link--aktiv']}
                aria-current={istAktiv ? 'page' : undefined}
              >
                {punkt.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="menue-sheet__fuss">
      <a href={kontakt.telefon.link} class="menue-sheet__btn menue-sheet__btn--rot">
        <Image src={telefonIcon} alt="" width={20} height={20} class="menue-sheet__icon" aria-hidden="true" />
        <span>{texte.header.anrufen} · {kontakt.telefon.anzeige}</span>
      </a>
      <a
        href={kontakt.whatsapp.link}
        class="menue-sheet__btn menue-sheet__btn--gruen"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={texte.header.whatsappAriaLabel}
      >
        <Image src={whatsappIcon} alt="" width={20} height={20} class="menue-sheet__icon" aria-hidden="true" />
        <span>{texte.header.whatsappButton}</span>
      </a>
      <p class="menue-sheet__zeiten">{oeffnungszeitenKurz}</p>
    </div>
  </div>
</header>
)}

{variante !== 'unterseite' && (
<script is:inline>
  (() => {
    const burger = document.querySelector('.header__burger');
    const sheet = document.getElementById('menue-sheet');
    if (!burger || !sheet) return;

    const html = document.documentElement;
    const schliessenKnopf = sheet.querySelector('.menue-sheet__zu');
    const desktop = window.matchMedia('(min-width: 1024px)');
    const labelOeffnen = burger.dataset.labelOeffnen || '';
    const labelSchliessen = burger.dataset.labelSchliessen || '';
    const istOffen = () => sheet.classList.contains('ist-offen');

    const oeffnen = () => {
      sheet.classList.add('ist-offen');
      html.classList.add('menue-offen');
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', labelSchliessen);
      // Fokus auf den ersten Menüpunkt
      const ersterLink = sheet.querySelector('.menue-link');
      if (ersterLink) ersterLink.focus({ preventScroll: true });
    };

    const schliessen = (fokusZurueck) => {
      sheet.classList.remove('ist-offen');
      html.classList.remove('menue-offen');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', labelOeffnen);
      if (fokusZurueck) burger.focus({ preventScroll: true });
    };

    burger.addEventListener('click', () => (istOffen() ? schliessen(false) : oeffnen()));
    if (schliessenKnopf) schliessenKnopf.addEventListener('click', () => schliessen(true));

    // Links im Sheet schließen das Menü
    sheet.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (istOffen()) schliessen(true);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (!istOffen()) return;

      // Escape schließt, Fokus zurück an den Burger
      if (event.key === 'Escape') {
        schliessen(true);
        return;
      }

      // Fokusfalle innerhalb des Sheets
      if (event.key === 'Tab') {
        const elemente = Array.from(sheet.querySelectorAll('a[href], button:not([disabled])'));
        if (elemente.length === 0) return;
        const erstes = elemente[0];
        const letztes = elemente[elemente.length - 1];
        const aktuell = document.activeElement;
        const imSheet = sheet.contains(aktuell);

        if (event.shiftKey && (!imSheet || aktuell === erstes)) {
          event.preventDefault();
          letztes.focus();
        } else if (!event.shiftKey && (!imSheet || aktuell === letztes)) {
          event.preventDefault();
          erstes.focus();
        }
      }
    });

    // Beim Wechsel auf Desktop-Breite das Sheet sauber schließen (Scroll-Sperre aufheben)
    desktop.addEventListener('change', (event) => {
      if (event.matches && istOffen()) schliessen(false);
    });
  })();
</script>
)}

<style>
  .header {
    position: fixed;
    top: var(--header-top, 0px);
    inset-inline: 0;
    width: 100%;
    color: var(--farbe-text-hell);
    z-index: 50;
  }

  /* Menü offen: Header (mit Sheet) über Demo-Balken, Hinweis und Aktionsleiste */
  :global(html.menue-offen) .header {
    z-index: 100;
  }

  /* Dunkler Verlauf oben über dem Hero-Foto (Figma: ca. 305px hoch, 60% Schwarz → transparent) */
  .header--transparent::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 19rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--farbe-schwarz) 60%, transparent) 0%,
      transparent 100%
    );
    pointer-events: none;
    z-index: -1;
    transition: opacity 200ms ease;
  }

  .header--fest {
    background-color: transparent;
  }

  .header__leiste {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--abstand-s);
    padding: var(--abstand-s) var(--container-rand);
    position: relative;
  }

  /* Kleines Logo mobil (ohne Seitenverhältnis zu verzerren), 32px hoch */
  .header__logo-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo {
    height: 32px;
    width: auto;
    aspect-ratio: 119 / 87;
  }

  /* Mobile Aktionen rechts (nur Burger) */
  .header__mobil-aktionen {
    display: flex;
    align-items: center;
  }

  /* Burger-Button: 44×44 px Tippfläche, nur drei abgerundete Striche */
  .header__burger {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
  }

  .header__burger:focus-visible {
    outline-color: var(--farbe-rot);
  }

  .header__burger-linie {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--farbe-leiste-text);
    transition:
      transform var(--dauer-kurz) ease,
      opacity var(--dauer-kurz) ease,
      background-color 200ms ease;
  }

  .header__burger[aria-expanded='true'] .header__burger-linie:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__burger[aria-expanded='true'] .header__burger-linie:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded='true'] .header__burger-linie:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Desktop-Telefonbutton erst ab 1024px */
  .header__telefon-desktop {
    display: none;
  }

  /* Desktop-Navigation: unter 1024px ausgeblendet, dort übernimmt das Sheet */
  .header__nav {
    display: none;
  }

  /* ---------- Menü-Sheet (Vollbild, nur < 1024px) ---------- */
  .menue-sheet {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    z-index: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--farbe-offwhite);
    color: var(--farbe-leiste-text);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: calc(var(--abstand-m) + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 250ms ease-out,
      visibility 0s linear 250ms;
  }

  .menue-sheet.ist-offen {
    transform: none;
    visibility: visible;
    transition: transform 250ms ease-out;
  }

  .menue-sheet :focus-visible {
    outline-color: var(--farbe-rot);
  }

  .menue-sheet__kopf {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--leiste-hoehe);
    padding: env(safe-area-inset-top, 0px) var(--container-rand) 0;
  }

  .menue-sheet__logo {
    display: inline-flex;
    align-items: center;
  }

  .menue-sheet__logo-bild {
    height: 32px;
    width: auto;
    aspect-ratio: 119 / 87;
  }

  /* Schließen-X: 44×44 px Tippfläche, Striche liegen exakt über dem Burger */
  .menue-sheet__zu {
    position: relative;
    width: 44px;
    height: 44px;
    margin-inline-end: -11px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .menue-sheet__zu::before,
  .menue-sheet__zu::after {
    content: '';
    position: absolute;
    left: 11px;
    top: calc(50% - 1px);
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--farbe-leiste-text);
  }

  .menue-sheet__zu::before {
    transform: rotate(45deg);
  }

  .menue-sheet__zu::after {
    transform: rotate(-45deg);
  }

  .menue-sheet__nav {
    padding: var(--abstand-xs) var(--container-rand) 0;
  }

  .menue-sheet__liste {
    list-style: none;
  }

  .menue-sheet__liste li + li {
    border-top: 0.5px solid rgba(0, 0, 0, 0.15);
  }

  /* iOS-Liste: große Zeile, fette Schrift, Chevron rechts */
  .menue-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding-block: var(--abstand-xs);
    color: var(--farbe-leiste-text);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: 1.375rem;
    line-height: 1.2;
    text-decoration: none;
    transition:
      transform 100ms ease,
      opacity 100ms ease;
  }

  .menue-link::after {
    content: '';
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    margin-inline-end: 4px;
    border-top: 2px solid rgba(0, 0, 0, 0.3);
    border-right: 2px solid rgba(0, 0, 0, 0.3);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  /* Aktiver Punkt: rot, kleiner roter Punkt links */
  .menue-link--aktiv {
    color: var(--farbe-rot);
  }

  .menue-link--aktiv::before {
    content: '';
    position: absolute;
    left: -16px;
    top: calc(50% - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--farbe-rot);
  }

  .menue-sheet__fuss {
    margin-top: auto;
    padding: var(--abstand-l) var(--container-rand) 0;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-s);
  }

  .menue-sheet__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--abstand-xs);
    height: 50px;
    border-radius: 14px;
    color: var(--farbe-text-hell);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: 1.0625rem;
    text-decoration: none;
    transition:
      transform 100ms ease,
      opacity 100ms ease;
  }

  .menue-sheet__btn--rot {
    background-color: var(--farbe-rot);
  }

  .menue-sheet__btn--gruen {
    background-color: var(--farbe-gruen);
  }

  .menue-sheet__icon {
    flex-shrink: 0;
    object-fit: contain;
  }

  .menue-sheet__zeiten {
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--farbe-leiste-text) 70%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .menue-sheet,
    .menue-sheet.ist-offen {
      transition: none;
    }
  }

  /* Ohne JS: Menü als einfache Liste unter der Leiste, kein Vollbild */
  :global(html:not(.js)) .header__burger {
    display: none;
  }

  :global(html:not(.js)) .header--transparent,
  :global(html:not(.js)) .header--fest {
    position: relative;
    top: auto;
    background-color: var(--farbe-offwhite);
  }

  :global(html:not(.js)) .header--transparent::before {
    display: none;
  }

  :global(html:not(.js)) .menue-sheet {
    position: static;
    height: auto;
    transform: none;
    visibility: visible;
    transition: none;
    overflow: visible;
  }

  :global(html:not(.js)) .menue-sheet__kopf {
    display: none;
  }

  .header__liste {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-2xs);
  }

  .header__link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--abstand-xs) var(--abstand-m);
    color: var(--farbe-text-hell);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-basis);
    text-decoration: none;
    border-radius: var(--radius-badge);
    transition:
      background-color var(--dauer-kurz) ease,
      transform 100ms ease,
      opacity 100ms ease;
  }

  .header__link--aktiv,
  .header__link--aktiv:hover {
    background-color: var(--farbe-rot);
  }

  /* ---------- Mobil/Tablet (< 1024px): kompakte Leiste, "Large Title"-Muster ---------- */
  @media (max-width: 1023px) {
    :global(html.gescrollt) .header--transparent::before {
      opacity: 0;
    }

    .header__leiste {
      flex-wrap: nowrap;
      height: var(--leiste-hoehe);
      padding: env(safe-area-inset-top, 0px) var(--container-rand) 0;
      isolation: isolate;
    }

    /* Material: durchscheinende, unscharfe Leiste mit 0,5px-Haarlinie. Als Pseudo-Element,
       damit das Sheet (position: fixed) nicht an einem backdrop-filter des Headers hängt. */
    .header__leiste::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--farbe-offwhite); /* deckend: nichts scheint durch (Nutzerwunsch) */
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 0.5px solid rgba(0, 0, 0, 0.15);
      pointer-events: none;
      transition:
        opacity 200ms ease,
        transform 200ms ease;
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .header__leiste::before {
        background-color: var(--farbe-offwhite);
      }
    }

    .header__logo-link {
      transition:
        opacity 200ms ease,
        visibility 200ms ease;
    }

    .header__mobil-aktionen {
      margin-inline-end: -11px;
    }

    /* Ganz oben (scrollY <= 8) auf der Startseite: nur Burger (offwhite über dem Foto), Logo und Material aus */
    :global(html.js:not(.gescrollt)) .header--transparent .header__leiste::before {
      opacity: 0;
      transform: translateY(-8px);
    }

    :global(html.js:not(.gescrollt)) .header--transparent .header__logo-link {
      opacity: 0;
      visibility: hidden;
    }

    :global(html.js:not(.gescrollt)) .header--transparent .header__burger-linie {
      background-color: var(--farbe-offwhite);
    }

    :global(html.js:not(.gescrollt)) .header--transparent .header__burger:focus-visible {
      outline-color: var(--farbe-offwhite);
    }


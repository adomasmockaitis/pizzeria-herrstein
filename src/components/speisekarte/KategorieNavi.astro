---
// Sticky Kategorie-Navigation als horizontale Pill-Leiste mit gleitendem Aktiv-Indikator
import texte from '../../content/texte.json';

interface KategorieLink {
  id: string;
  name: string;
}

interface Props {
  kategorien: KategorieLink[];
}

const { kategorien } = Astro.props;
---

<div class="kat-navi-leiste" data-kat-navi-leiste>
  <nav class="kat-navi" aria-label={texte.speisekarte.kategorieNaviLabel}>
    <div class="kat-navi__scroller" data-kat-scroller>
      <div class="kat-navi__spur" data-kat-spur>
        <span class="kat-navi__indikator" data-kat-indikator aria-hidden="true" hidden></span>
        <ul class="kat-navi__liste" data-kat-navi-liste>
          {kategorien.map((kategorie, index) => (
            <li class="kat-navi__item" data-kat-item={kategorie.id}>
              <a
                href={`#${kategorie.id}`}
                class:list={['kat-navi__link', index === 0 && 'kat-navi__link--aktiv auf-rot']}
                aria-current={index === 0 ? 'true' : undefined}
                data-kat-link={kategorie.id}
                data-farbe={index % 2 === 0 ? 'rot' : 'gruen'}
              >
                {kategorie.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</div>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-kat-scroller]');
  const spur = document.querySelector<HTMLElement>('[data-kat-spur]');
  const liste = document.querySelector<HTMLElement>('[data-kat-navi-liste]');
  const indikator = document.querySelector<HTMLElement>('[data-kat-indikator]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-kat-link]'));
  const sektionen = Array.from(
    document.querySelectorAll<HTMLElement>('[data-kategorie-sektion]'),
  );

  if (scroller && spur && liste && indikator && links.length > 0 && sektionen.length > 0) {
    const reduziertMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
    const linkNachId = new Map<string, HTMLAnchorElement>();
    const itemNachId = new Map<string, HTMLElement>();

    for (const link of links) {
      const id = link.dataset.katLink;
      if (id) {
        linkNachId.set(id, link);
        const item = link.closest<HTMLElement>('[data-kat-item]');
        if (item) itemNachId.set(id, item);
      }
    }

    let aktiveId = links[0].dataset.katLink ?? '';
    let indikatorAnim: Animation | undefined;
    let indikatorInitialisiert = false;
    let klickZielId: string | null = null;
    let klickSperreTimer: number | undefined;

    const istSichtbarId = (id: string): boolean => {
      const item = itemNachId.get(id);
      return Boolean(item && !item.hidden);
    };

    const ersteSichtbareSektionId = (): string => {
      for (const sektion of sektionen) {
        if (!sektion.hidden && sektion.dataset.kategorieSektion) {
          return sektion.dataset.kategorieSektion;
        }
      }
      return '';
    };

    const bewegeIndikator = (link: HTMLAnchorElement | undefined, animieren: boolean) => {
      if (!link || link.closest<HTMLElement>('[data-kat-item]')?.hidden) {
        indikatorAnim?.cancel();
        indikatorAnim = undefined;
        indikator.hidden = true;
        indikatorInitialisiert = false;
        liste.classList.remove('hat-indikator');
        return;
      }

      const spurRect = spur.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const zielLinks = linkRect.left - spurRect.left;
      const zielBreite = linkRect.width;

      if (zielBreite <= 0) return;

      let altLinks = zielLinks;
      let altBreite = zielBreite;
      const kannAnimieren =
        animieren &&
        indikatorInitialisiert &&
        !indikator.hidden &&
        !reduziertMedia.matches &&
        typeof indikator.animate === 'function';

      if (kannAnimieren) {
        const indRect = indikator.getBoundingClientRect();
        altLinks = indRect.left - spurRect.left;
        altBreite = indRect.width;
      }

      indikatorAnim?.cancel();
      indikatorAnim = undefined;

      indikator.hidden = false;
      liste.classList.add('hat-indikator');
      indikator.style.width = `${zielBreite}px`;
      indikator.style.transform = `translateX(${zielLinks}px) scaleX(1)`;
      indikatorInitialisiert = true;

      if (
        kannAnimieren &&
        altBreite > 0 &&
        (Math.abs(altLinks - zielLinks) > 0.5 || Math.abs(altBreite - zielBreite) > 0.5)
      ) {
        indikatorAnim = indikator.animate(
          [
            { transform: `translateX(${altLinks}px) scaleX(${altBreite / zielBreite})` },
            { transform: `translateX(${zielLinks}px) scaleX(1)` },
          ],
          {
            duration: 300,
            easing: 'cubic-bezier(0.32, 0.72, 0, 1)',
          },
        );
      }
    };

    const scrolleLinkInsBild = (link: HTMLAnchorElement) => {
      const linkRect = link.getBoundingClientRect();
      const scrollerRect = scroller.getBoundingClientRect();
      const istImBild =
        linkRect.left >= scrollerRect.left + 8 && linkRect.right <= scrollerRect.right - 8;
      if (istImBild) return;

      const zielScroll =
        scroller.scrollLeft +
        (linkRect.left - scrollerRect.left) -
        (scroller.clientWidth - linkRect.width) / 2;
      scroller.scrollTo({
        left: Math.max(0, zielScroll),
        behavior: reduziertMedia.matches ? 'auto' : 'smooth',
      });
    };

    const setzeAktiv = (id: string, inLeisteScrollen = true, animieren = true) => {
      if (!id || !linkNachId.has(id) || !istSichtbarId(id)) {
        bewegeIndikator(undefined, false);
        aktiveId = '';
        return;
      }

      const geaendert = id !== aktiveId;
      aktiveId = id;

      for (const link of links) {
        const istAktiv = link.dataset.katLink === id;
        link.classList.toggle('kat-navi__link--aktiv', istAktiv);
        if (istAktiv) {
          // Indikator in der Kategoriefarbe (Rot/Grün wie die Abschnitte)
          indikator.style.backgroundColor =
            link.dataset.farbe === 'gruen' ? 'var(--farbe-gruen)' : 'var(--farbe-rot)';
        }
        link.classList.toggle('auf-rot', istAktiv);
        if (istAktiv) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }

      const aktiverLink = linkNachId.get(id);
      bewegeIndikator(aktiverLink, animieren && geaendert);

      if (inLeisteScrollen && geaendert && aktiverLink) {
        scrolleLinkInsBild(aktiverLink);
      }
    };

    const loeseKlickSperre = () => {
      window.clearTimeout(klickSperreTimer);
      klickZielId = null;
    };

    for (const link of links) {
      link.addEventListener('click', () => {
        const id = link.dataset.katLink;
        if (!id) return;
        klickZielId = id;
        window.clearTimeout(klickSperreTimer);
        klickSperreTimer = window.setTimeout(loeseKlickSperre, 800);
        window.dispatchEvent(new CustomEvent('speisekarte:ankersprung', { detail: { id } }));
        setzeAktiv(id, true, true);
      });
    }

    window.addEventListener('wheel', loeseKlickSperre, { passive: true });
    window.addEventListener('touchstart', loeseKlickSperre, { passive: true });
    window.addEventListener('scrollend', loeseKlickSperre, { passive: true });

    const aktualisiereAusScroll = () => {
      if (klickZielId) return;

      const sichtbareSektionen = sektionen.filter((s) => !s.hidden);
      if (sichtbareSektionen.length === 0) {
        bewegeIndikator(undefined, false);
        aktiveId = '';
        return;
      }

      const lesezone = window.innerHeight * 0.33;
      let aktuell = sichtbareSektionen[0].dataset.kategorieSektion ?? '';
      for (const sektion of sichtbareSektionen) {
        if (sektion.getBoundingClientRect().top <= lesezone) {
          aktuell = sektion.dataset.kategorieSektion ?? aktuell;
        } else {
          break;
        }
      }
      if (aktuell !== aktiveId) {
        setzeAktiv(aktuell, true, true);
      }
    };

    window.addEventListener('scroll', aktualisiereAusScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        const aktiverLink = aktiveId ? linkNachId.get(aktiveId) : undefined;
        bewegeIndikator(aktiverLink, false);
        aktualisiereAusScroll();
      },
      { passive: true },
    );

    // Reagiert auf Suchfilter: aktualisiert aktive Pill und Indikatorposition
    window.addEventListener('speisekarte:filter', () => {
      loeseKlickSperre();
      const sichtbareId = aktiveId && istSichtbarId(aktiveId) ? aktiveId : ersteSichtbareSektionId();
      if (!sichtbareId) {
        bewegeIndikator(undefined, false);
        aktiveId = '';
        return;
      }
      setzeAktiv(sichtbareId, false, false);
      aktualisiereAusScroll();
      const aktuellerLink = aktiveId ? linkNachId.get(aktiveId) : undefined;
      bewegeIndikator(aktuellerLink, false);
    });

    const startHash = window.location.hash.replace(/^#/, '');
    if (startHash && linkNachId.has(startHash)) {
      setzeAktiv(startHash, true, false);
    } else {
      aktualisiereAusScroll();
      const startLink = aktiveId ? linkNachId.get(aktiveId) : links[0];
      bewegeIndikator(startLink, false);
    }
  }
</script>

<style>
  .kat-navi-leiste {
    position: sticky;
    top: var(--nav-hoehe);
    z-index: 40;
    height: var(--katnavi-hoehe);
    background-color: var(--farbe-offwhite); /* deckend: nichts scheint durch (Nutzerwunsch) */
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-top: 0.5px solid var(--farbe-haarlinie);
    border-bottom: 0.5px solid var(--farbe-haarlinie-stark);
  }

  :global(html.js) .kat-navi-leiste {
    top: calc(var(--nav-hoehe) + var(--header-top, 0px));
  }

  @media (max-width: 1023px) {
    :global(html:not(.js)) .kat-navi-leiste {
      top: 0;
    }
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .kat-navi-leiste {
      background-color: var(--farbe-offwhite);
    }
  }

  .kat-navi {
    width: 100%;
    max-width: var(--container-max);
    height: 100%;
    margin-inline: auto;
  }

  .kat-navi__scroller {
    height: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--container-rand);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .kat-navi__scroller::-webkit-scrollbar {
    display: none;
  }

  .kat-navi__spur {
    position: relative;
    display: flex;
    align-items: center;
    width: max-content;
    min-width: 100%;
    height: 100%;
    padding-inline: var(--container-rand);
  }

  .kat-navi__indikator {
    position: absolute;
    left: 0;
    top: 50%;
    height: 2.75rem;
    margin-top: -1.375rem;
    border-radius: var(--radius-pill);
    background-color: var(--farbe-rot);
    z-index: 0;
    pointer-events: none;
    transform-origin: left center;
    will-change: transform;
      transition: background-color 300ms var(--kurve-ios);
  }

  .kat-navi__indikator[hidden] {
    display: none;
  }

  .kat-navi__liste {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--abstand-xs);
  }

  .kat-navi__item {
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .kat-navi__item[hidden] {
    display: none;
  }

  .kat-navi__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--abstand-m);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--farbe-schwarz) 6%, transparent);
    color: var(--farbe-leiste-text);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-m);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dauer-kurz) ease,
      color 200ms var(--kurve-ein),
      transform 100ms ease,
      opacity 100ms ease;
  }

  .kat-navi__link--aktiv[data-farbe='gruen'] {
    background-color: var(--farbe-gruen);
  }

  .kat-navi__link--aktiv {
    background-color: var(--farbe-rot);
    color: var(--farbe-text-hell);
  }

  /* Sobald der gleitende Indikator aktiv ist, liefert er den roten Hintergrund */
  .kat-navi__liste.hat-indikator .kat-navi__link--aktiv {
    background-color: transparent;
  }

  @media (hover: hover) {
    .kat-navi__link:not(.kat-navi__link--aktiv):hover {
      background-color: color-mix(in srgb, var(--farbe-schwarz) 11%, transparent);
    }

    .kat-navi__liste:not(.hat-indikator) .kat-navi__link--aktiv:hover {
      background-color: var(--farbe-rot-dunkel);
    }
  }

  @media (min-width: 1024px) {
    .kat-navi__liste {
      margin-inline: auto;
      gap: var(--abstand-s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kat-navi__link {
      transition: none;
    }
  }
</style>

---
// Allergen- und Zusatzstoff-Legende sowie Stand- und Personal-Hinweis am Ende der Speisekarte
import texte from '../../content/texte.json';
import {
  formatiereStand,
  type SpeisekarteLegende,
} from '../../scripts/speisekarte-typen';

interface Props {
  legende: SpeisekarteLegende;
  stand: string;
}

const { legende, stand } = Astro.props;

const hatZusatzstoffe = legende.zusatzstoffe.length > 0;
const hatAllergene = legende.allergene.length > 0;
const zeigeUnsicherHinweis = legende.unsicher || (!hatZusatzstoffe && !hatAllergene);

const formatierterStand = formatiereStand(stand);
const standText = formatierterStand
  ? texte.speisekarte.standHinweis.replace('{stand}', formatierterStand)
  : texte.speisekarte.standFallback;
---

<section class="legende" aria-labelledby="legende-titel">
  <div class="container">
    <div class="legende__box">
      <h2 id="legende-titel" class="legende__titel">
        {texte.speisekarte.legendeUeberschrift}
      </h2>

      {zeigeUnsicherHinweis && (
        <p class="legende__hinweis" role="note">
          {texte.speisekarte.legendeUnsicherHinweis}
        </p>
      )}

      {(hatZusatzstoffe || hatAllergene) && (
        <div class="legende__spalten">
          {hatZusatzstoffe && (
            <div class="legende__gruppe">
              <h3 class="legende__untertitel">{texte.speisekarte.zusatzstoffeTitel}</h3>
              <dl class="legende__liste">
                {legende.zusatzstoffe.map((eintrag) => (
                  <div class="legende__eintrag">
                    <dt class="legende__kuerzel">{eintrag.kuerzel}</dt>
                    <dd class="legende__text">{eintrag.text}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {hatAllergene && (
            <div class="legende__gruppe">
              <h3 class="legende__untertitel">{texte.speisekarte.allergeneTitel}</h3>
              <dl class="legende__liste">
                {legende.allergene.map((eintrag) => (
                  <div class="legende__eintrag">
                    <dt class="legende__kuerzel">{eintrag.kuerzel}</dt>
                    <dd class="legende__text">{eintrag.text}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      )}

      <div class="legende__fuss">
        <p class="legende__stand">{standText}</p>
        <p class="legende__personal">{texte.speisekarte.personalHinweis}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .legende {
    margin-top: var(--abstand-2xl);
  }

  .legende__box {
    --karte-innen: var(--abstand-m);
    padding: var(--karte-innen);
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
    background-color: var(--farbe-weiss);
    box-shadow:
      0 0 0 1px var(--farbe-haarlinie),
      var(--schatten-liste);
  }

  @media (min-width: 768px) {
    .legende__box {
      --karte-innen: var(--abstand-l);
    }
  }

  @media (min-width: 1024px) {
    .legende__box {
      --karte-innen: 1.75rem;
    }
  }

  .legende__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-xl);
    line-height: var(--zeilenhoehe-eng);
    color: var(--farbe-leiste-text);
    margin-bottom: var(--abstand-m);
  }

  .legende__hinweis {
    padding: var(--abstand-s) var(--abstand-m);
    margin-bottom: var(--abstand-l);
    border-left: 3px solid var(--farbe-rot);
    border-radius: 0 var(--radius-innen) var(--radius-innen) 0;
    background-color: color-mix(in srgb, var(--farbe-rot) 6%, var(--farbe-offwhite));
    font-size: var(--text-m);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-leiste-text);
    max-width: none;
  }

  .legende__spalten {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abstand-xl);
  }

  @media (min-width: 768px) {
    .legende__spalten {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--abstand-xl);
    }
  }

  .legende__untertitel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: 0.9375rem;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--farbe-text-sekundaer);
    margin-bottom: var(--abstand-s);
  }

  .legende__liste {
    margin: 0;
    display: grid;
    gap: var(--abstand-xs);
  }

  .legende__eintrag {
    display: grid;
    grid-template-columns: minmax(2.25rem, auto) minmax(0, 1fr);
    gap: var(--abstand-xs);
    align-items: baseline;
    font-size: var(--text-m);
    line-height: var(--zeilenhoehe);
  }

  .legende__kuerzel {
    font-weight: var(--gewicht-fett);
    color: var(--farbe-rot);
  }

  .legende__text {
    margin: 0;
    color: var(--farbe-text-sekundaer);
  }

  .legende__fuss {
    margin-top: var(--abstand-l);
    padding-top: var(--abstand-m);
    border-top: 1px solid var(--farbe-haarlinie);
    display: flex;
    flex-direction: column;
    gap: var(--abstand-xs);
  }

  .legende__stand,
  .legende__personal {
    font-size: var(--text-m);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  .legende__stand {
    font-weight: var(--gewicht-fett);
    color: var(--farbe-leiste-text);
  }
</style>

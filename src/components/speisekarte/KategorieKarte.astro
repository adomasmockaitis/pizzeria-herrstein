---
// Ein Kategorie-Abschnitt der Speisekarte (Überschrift + große farbige Karte mit Gerichten)
import Karte from '../Karte.astro';
import texte from '../../content/texte.json';
import {
  formatierePreis,
  type SpeisekarteKategorie,
} from '../../scripts/speisekarte-typen';

interface Props {
  kategorie: SpeisekarteKategorie;
  farbe: 'rot' | 'gruen';
}

const { kategorie, farbe } = Astro.props;
const titelId = `kat-titel-${kategorie.id}`;
---

<section
  id={kategorie.id}
  class="kategorie-sektion"
  aria-labelledby={titelId}
  data-kategorie-sektion={kategorie.id}
>
  <div class="container">
    <header class="kategorie-sektion__kopf">
      <h2 id={titelId} class="kategorie-sektion__titel">{kategorie.name}</h2>
      {kategorie.hinweis && <p class="kategorie-sektion__hinweis">{kategorie.hinweis}</p>}
    </header>

    <Karte farbe={farbe} schatten class="kategorie-karte">
      {kategorie.abschnitte.map((abschnitt, abschnittIndex) => {
        const hatEinzelpreise = abschnitt.gerichte.some((g) => g.preis !== null);
        const hatZweiGroessen = Boolean(
          kategorie.groessen &&
            (abschnitt.gerichte.some(
              (g) => g.preisKlein !== null || g.preisGross !== null,
            ) ||
              !hatEinzelpreise),
        );
        const abschnittTitelId = abschnitt.titel
          ? `${kategorie.id}-abschnitt-${abschnittIndex}`
          : undefined;

        return (
          <div
            class:list={[
              'abschnitt',
              abschnittIndex > 0 && 'abschnitt--getrennt',
            ]}
          >
            {(abschnitt.titel || abschnitt.hinweis) && (
              <div class="abschnitt__kopf">
                {abschnitt.titel && (
                  <h3 id={abschnittTitelId} class="abschnitt__titel">
                    {abschnitt.titel}
                  </h3>
                )}
                {abschnitt.hinweis && (
                  <p class="abschnitt__hinweis">{abschnitt.hinweis}</p>
                )}
              </div>
            )}

            {hatZweiGroessen && kategorie.groessen && (
              <div class="groessen-kopf" aria-hidden="true">
                <span class="groessen-kopf__leer"></span>
                <span class="groessen-kopf__leer groessen-kopf__leer--beschreibung"></span>
                <span class="groessen-kopf__spalte">{kategorie.groessen.klein}</span>
                <span class="groessen-kopf__spalte">{kategorie.groessen.gross}</span>
              </div>
            )}

            <ul class="gerichte-liste" aria-labelledby={abschnittTitelId}>
              {abschnitt.gerichte.map((gericht) => {
                // „?“ nur, wenn Name/Beschreibung/Preis unsicher sind. Fehlende Allergen-Kürzel
                // betreffen fast alle Gerichte und werden über den Hinweis in der Legende abgedeckt.
                const istUnsicher = (gericht.unsicher ?? []).some((feld) => feld !== 'kennzeichnung');
                const hatKennzeichnung =
                  gericht.kennzeichnung && gericht.kennzeichnung.length > 0;
                const einzelPreis = formatierePreis(gericht.preis);
                const kleinPreis = formatierePreis(gericht.preisKlein);
                const grossPreis = formatierePreis(gericht.preisGross);

                return (
                  <li
                    class:list={[
                      'gericht',
                      hatZweiGroessen ? 'gericht--zwei-preise' : 'gericht--ein-preis',
                    ]}
                  >
                    <div class="gericht__kopf">
                      <span class="gericht__name">{gericht.name}</span>
                      {gericht.zusatz && (
                        <span class="gericht__zusatz">{gericht.zusatz}</span>
                      )}
                      {gericht.vegetarisch && (
                        <span
                          class="gericht__badge gericht__badge--vegetarisch"
                          role="img"
                          aria-label={texte.speisekarte.vegetarischLabel}
                          title={texte.speisekarte.vegetarischLabel}
                        >
                          <svg
                            viewBox="0 0 16 16"
                            width="15"
                            height="15"
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d="M13.5 2.5C8.5 2.5 4.2 5.2 3.2 10.5c-.2 1.1.7 2 1.8 1.8C10.3 11.3 13.5 7.5 13.5 2.5Z"
                              fill="currentColor"
                            />
                            <path
                              d="M3 13.5c1.6-2.4 4.2-4.8 7.5-6.5"
                              stroke="currentColor"
                              stroke-width="1.3"
                              stroke-linecap="round"
                            />
                          </svg>
                        </span>
                      )}
                      {istUnsicher && (
                        <span
                          class="gericht__badge gericht__badge--unsicher"
                          role="img"
                          aria-label={texte.speisekarte.unsicherLabel}
                          title={texte.speisekarte.unsicherLabel}
                        >
                          ?
                        </span>
                      )}
                    </div>

                    {gericht.beschreibung && (
                      <p class="gericht__beschreibung">{gericht.beschreibung}</p>
                    )}

                    {hatKennzeichnung && (
                      <p class="gericht__kennzeichnung">
                        {gericht.kennzeichnung.join(', ')}
                      </p>
                    )}

                    {hatZweiGroessen && kategorie.groessen ? (
                      <>
                        <span class="gericht__preis gericht__preis--klein">
                          <span class="visually-hidden">
                            {kategorie.groessen.klein}:{' '}
                          </span>
                          {gericht.preisKlein === null ? (
                            <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                              {kleinPreis}
                            </span>
                          ) : (
                            kleinPreis
                          )}
                        </span>
                        <span class="gericht__preis gericht__preis--gross">
                          <span class="visually-hidden">
                            {kategorie.groessen.gross}:{' '}
                          </span>
                          {gericht.preisGross === null ? (
                            <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                              {grossPreis}
                            </span>
                          ) : (
                            grossPreis
                          )}
                        </span>
                      </>
                    ) : (
                      <span class="gericht__preis gericht__preis--einzel">
                        {gericht.preis === null ? (
                          <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                            {einzelPreis}
                          </span>
                        ) : (
                          einzelPreis
                        )}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </Karte>
  </div>
</section>

<style>
  /* Abstand für Anker-Sprünge: feste Header-Leiste + sticky Kategorie-Navi + Luft */
  .kategorie-sektion {
    scroll-margin-top: calc(var(--aktuelle-leiste-hoehe) + 4.5rem);
  }

  .kategorie-sektion + .kategorie-sektion {
    margin-top: var(--abstand-sektion);
  }

  .kategorie-sektion__kopf {
    text-align: center;
    margin-bottom: var(--abstand-l);
  }

  .kategorie-sektion__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-2xl);
    line-height: var(--zeilenhoehe-eng);
    color: var(--farbe-text);
  }

  .kategorie-sektion__hinweis {
    margin-top: var(--abstand-xs);
    margin-inline: auto;
    font-size: var(--text-m);
    color: color-mix(in srgb, var(--farbe-text) 78%, transparent);
  }

  .abschnitt--getrennt {
    margin-top: var(--abstand-xl);
    padding-top: var(--abstand-l);
    border-top: 1px solid color-mix(in srgb, var(--farbe-offwhite) 30%, transparent);
  }

  .abschnitt__kopf {
    margin-bottom: var(--abstand-m);
  }

  .abschnitt__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-l);
    line-height: var(--zeilenhoehe-eng);
  }

  .abschnitt__hinweis {
    margin-top: var(--abstand-2xs);
    font-size: var(--text-s);
    color: color-mix(in srgb, var(--farbe-offwhite) 90%, transparent);
    max-width: none;
  }

  /* Kopfzeile für zwei Preisspalten (z. B. Pizza klein / groß) */
  .groessen-kopf {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(3.75rem, auto) minmax(3.75rem, auto);
    column-gap: var(--abstand-s);
    align-items: end;
    padding-bottom: var(--abstand-xs);
    border-bottom: 1px solid color-mix(in srgb, var(--farbe-offwhite) 25%, transparent);
    margin-bottom: var(--abstand-2xs);
  }

  .groessen-kopf__leer--beschreibung {
    display: none;
  }

  .groessen-kopf__spalte {
    text-align: right;
    font-size: var(--text-xs);
    font-weight: var(--gewicht-fett);
    line-height: 1.25;
    color: color-mix(in srgb, var(--farbe-offwhite) 92%, transparent);
  }

  .gerichte-liste {
    list-style: none;
  }

  /* Mobil (Apple HIG / PLAN Abschnitt 8): Name & Preis in einer Zeile oben, Beschreibung darunter, Kennzeichnung darunter */
  .gericht {
    display: grid;
    row-gap: var(--abstand-2xs);
    column-gap: var(--abstand-s);
    padding-block: var(--abstand-m);
    align-items: baseline;
  }

  .gericht:first-child {
    padding-top: var(--abstand-xs);
  }

  .gericht:last-child {
    padding-bottom: var(--abstand-xs);
  }

  .gericht + .gericht {
    border-top: 1px solid color-mix(in srgb, var(--farbe-offwhite) 20%, transparent);
  }

  .gericht--ein-preis {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'kopf preis-einzel'
      'beschreibung beschreibung'
      'kennzeichnung kennzeichnung';
  }

  .gericht--zwei-preise {
    grid-template-columns: minmax(0, 1fr) minmax(3.75rem, auto) minmax(3.75rem, auto);
    grid-template-areas:
      'kopf preis-klein preis-gross'
      'beschreibung beschreibung beschreibung'
      'kennzeichnung kennzeichnung kennzeichnung';
  }

  .gericht__kopf {
    grid-area: kopf;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.45rem;
    min-width: 0;
  }

  .gericht__name {
    font-weight: var(--gewicht-fett);
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .gericht__zusatz {
    font-weight: var(--gewicht-normal);
    font-size: var(--text-basis);
    line-height: 1.25;
    color: color-mix(in srgb, var(--farbe-offwhite) 94%, transparent);
  }

  .gericht__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .gericht__badge--vegetarisch {
    color: var(--farbe-offwhite);
    align-self: center;
  }

  .gericht__badge--unsicher {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--farbe-offwhite) 65%, transparent);
    font-size: var(--text-xs);
    font-weight: var(--gewicht-fett);
    line-height: 1;
    color: color-mix(in srgb, var(--farbe-offwhite) 92%, transparent);
    align-self: center;
  }

  .gericht__beschreibung {
    grid-area: beschreibung;
    font-weight: var(--gewicht-normal);
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
    max-width: none;
  }

  .gericht__kennzeichnung {
    grid-area: kennzeichnung;
    font-weight: var(--gewicht-normal);
    font-size: var(--text-xs);
    line-height: 1.35;
    color: color-mix(in srgb, var(--farbe-offwhite) 88%, transparent);
    max-width: none;
  }

  .gericht__preis {
    font-weight: var(--gewicht-fett);
    font-size: 1.0625rem;
    line-height: 1.25;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .gericht__preis--einzel {
    grid-area: preis-einzel;
  }

  .gericht__preis--klein {
    grid-area: preis-klein;
  }

  .gericht__preis--gross {
    grid-area: preis-gross;
  }

  @media (min-width: 768px) {
    .kategorie-sektion__kopf {
      margin-bottom: var(--abstand-xl);
    }

    .groessen-kopf {
      grid-template-columns: minmax(0, 1fr) minmax(6.5rem, auto) minmax(6.5rem, auto);
      column-gap: var(--abstand-l);
    }

    .gericht--zwei-preise {
      grid-template-columns: minmax(0, 1fr) minmax(6.5rem, auto) minmax(6.5rem, auto);
      column-gap: var(--abstand-l);
    }
  }

  /* Desktop (>= 1024px): 3-spaltiges Grid (bzw. 4 Spalten bei Pizza) wie Figma */
  @media (min-width: 1024px) {
    .kategorie-sektion {
      scroll-margin-top: calc(var(--aktuelle-leiste-hoehe) + 5rem);
    }

    .kategorie-sektion :global(.kategorie-karte) {
      padding: var(--abstand-xl) clamp(1.75rem, 3vw, 2.75rem);
    }

    .groessen-kopf {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr) minmax(7.5rem, 9.5rem) minmax(
          7.5rem,
          9.5rem
        );
      column-gap: var(--abstand-l);
    }

    .groessen-kopf__leer--beschreibung {
      display: block;
    }

    .groessen-kopf__spalte {
      font-size: var(--text-m);
    }

    .gericht {
      padding-block: 1.125rem;
      column-gap: var(--abstand-l);
      row-gap: var(--abstand-2xs);
      align-items: baseline;
    }

    .gericht--ein-preis {
      grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr) minmax(6rem, auto);
      grid-template-areas:
        'kopf beschreibung preis-einzel'
        'kennzeichnung beschreibung preis-einzel';
    }

    .gericht--zwei-preise {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr) minmax(7.5rem, 9.5rem) minmax(
          7.5rem,
          9.5rem
        );
      grid-template-areas:
        'kopf beschreibung preis-klein preis-gross'
        'kennzeichnung beschreibung preis-klein preis-gross';
    }

    .gericht__name {
      font-size: var(--text-l);
    }

    .gericht__zusatz {
      font-size: 1.125rem;
    }

    .gericht__beschreibung {
      font-size: 1.125rem;
    }

    .gericht__preis {
      font-size: var(--text-l);
    }
  }
</style>

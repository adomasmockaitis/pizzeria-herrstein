---
// Kategorie-Abschnitt mit mitlaufender Überschrift (sticky) und heller Gerichte-Liste
import AbschnittTitel from '../AbschnittTitel.astro';
import texte from '../../content/texte.json';
import {
  formatierePreis,
  type SpeisekarteKategorie,
} from '../../scripts/speisekarte-typen';

interface Props {
  kategorie: SpeisekarteKategorie;
  farbe: 'rot' | 'gruen';
}

const { kategorie, farbe } = Astro.props;
const titelId = `kat-titel-${kategorie.id}`;
const hatGroessen = Boolean(kategorie.groessen);
const istLangerHinweis = Boolean(kategorie.hinweis && kategorie.hinweis.length > 140);
---

<section
  id={kategorie.id}
  class="kategorie-sektion"
  aria-labelledby={titelId}
  data-kategorie-sektion={kategorie.id}
>
  <div class="kategorie-sektion__sentinel" aria-hidden="true" data-sticky-sentinel></div>

  <header class="kategorie-sektion__kopf" data-kategorie-kopf>
    <div class="container">
      <div
        class:list={[
          'kategorie-sektion__kopf-innen',
          hatGroessen && 'kategorie-sektion__kopf-innen--groessen',
        ]}
      >
        <AbschnittTitel
          id={titelId}
          farbe={farbe}
          variante="kompakt"
          class="kategorie-sektion__titel"
        >
          {kategorie.name}
        </AbschnittTitel>

        {hatGroessen && kategorie.groessen && (
          <div class="kategorie-sektion__groessen" aria-hidden="true">
            <span class="kategorie-sektion__groesse">{kategorie.groessen.klein}</span>
            <span class="kategorie-sektion__groesse">{kategorie.groessen.gross}</span>
          </div>
        )}
      </div>
    </div>
  </header>

  <div class="container">
    <div
      class:list={['kategorie-block', `kategorie-block--${farbe}`]}
      data-kategorie-block
      data-einblenden
    >
      {kategorie.hinweis && !istLangerHinweis && (
        <p class="kategorie-block__hinweis">{kategorie.hinweis}</p>
      )}

      {kategorie.abschnitte.map((abschnitt, abschnittIndex) => {
        const hatEinzelpreise = abschnitt.gerichte.some((g) => g.preis !== null);
        const hatZweiGroessen = Boolean(
          kategorie.groessen &&
            (abschnitt.gerichte.some(
              (g) => g.preisKlein !== null || g.preisGross !== null,
            ) ||
              !hatEinzelpreise),
        );
        const zeigeAbschnittTitel = Boolean(
          abschnitt.titel &&
            abschnitt.titel.trim().toLowerCase() !== kategorie.name.trim().toLowerCase(),
        );
        const abschnittTitelId = zeigeAbschnittTitel
          ? `${kategorie.id}-abschnitt-${abschnittIndex}`
          : undefined;

        return (
          <div class="abschnitt" data-abschnitt>
            {(zeigeAbschnittTitel || abschnitt.hinweis) && (
              <div class="abschnitt__kopf">
                {zeigeAbschnittTitel && (
                  <h3 id={abschnittTitelId} class="abschnitt__titel">
                    {abschnitt.titel}
                  </h3>
                )}
                {abschnitt.hinweis && (
                  <p class="abschnitt__hinweis">{abschnitt.hinweis}</p>
                )}
              </div>
            )}

            <ul class="gerichte-liste" aria-labelledby={abschnittTitelId} data-gerichte-liste>
              {abschnitt.gerichte.map((gericht, gerichtIndex) => {
                const istUnsicher = (gericht.unsicher ?? []).some(
                  (feld) => feld !== 'kennzeichnung',
                );
                const hatKennzeichnung =
                  gericht.kennzeichnung && gericht.kennzeichnung.length > 0;
                const einzelPreis = formatierePreis(gericht.preis);
                const kleinPreis = formatierePreis(gericht.preisKlein);
                const grossPreis = formatierePreis(gericht.preisGross);
                const filterPreis = gericht.preisKlein ?? gericht.preis ?? gericht.preisGross;

                return (
                  <li
                    class:list={[
                      'gericht',
                      hatZweiGroessen ? 'gericht--zwei-preise' : 'gericht--ein-preis',
                    ]}
                    data-gericht
                    data-index={gerichtIndex}
                    data-kategorie-id={kategorie.id}
                    data-kategorie-name={kategorie.name}
                    data-abschnitt-titel={abschnitt.titel ?? ''}
                    data-vegetarisch={gericht.vegetarisch ? '1' : undefined}
                    data-preis={filterPreis !== null && filterPreis !== undefined ? String(filterPreis) : undefined}
                    data-kennzeichnung={hatKennzeichnung ? gericht.kennzeichnung.join(',') : undefined}
                  >
                    <div class="gericht__kopf">
                      <span class="gericht__name" data-feld="name" data-original={gericht.name}>
                        {gericht.name}
                      </span>
                      {gericht.zusatz && (
                        <span
                          class="gericht__zusatz"
                          data-feld="zusatz"
                          data-original={gericht.zusatz}
                        >
                          {gericht.zusatz}
                        </span>
                      )}
                      {gericht.vegetarisch && (
                        <span
                          class="gericht__badge gericht__badge--vegetarisch"
                          role="img"
                          aria-label={texte.speisekarte.vegetarischLabel}
                          title={texte.speisekarte.vegetarischLabel}
                        >
                          <svg
                            viewBox="0 0 16 16"
                            width="15"
                            height="15"
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d="M13.5 2.5C8.5 2.5 4.2 5.2 3.2 10.5c-.2 1.1.7 2 1.8 1.8C10.3 11.3 13.5 7.5 13.5 2.5Z"
                              fill="currentColor"
                            />
                            <path
                              d="M3 13.5c1.6-2.4 4.2-4.8 7.5-6.5"
                              stroke="currentColor"
                              stroke-width="1.3"
                              stroke-linecap="round"
                            />
                          </svg>
                        </span>
                      )}
                      {istUnsicher && (
                        <span
                          class="gericht__badge gericht__badge--unsicher"
                          role="img"
                          aria-label={texte.speisekarte.unsicherLabel}
                          title={texte.speisekarte.unsicherLabel}
                        >
                          ?
                        </span>
                      )}
                    </div>

                    {gericht.beschreibung && (
                      <p
                        class="gericht__beschreibung"
                        data-feld="beschreibung"
                        data-original={gericht.beschreibung}
                      >
                        {gericht.beschreibung}
                      </p>
                    )}

                    {hatKennzeichnung && (
                      <p class="gericht__kennzeichnung">
                        {gericht.kennzeichnung.join(', ')}
                      </p>
                    )}

                    <p class="gericht__teiltreffer" hidden data-teiltreffer-info></p>

                    {hatZweiGroessen && kategorie.groessen ? (
                      <>
                        <span class="gericht__preis gericht__preis--klein">
                          <span class="visually-hidden">
                            {kategorie.groessen.klein}:{' '}
                          </span>
                          {gericht.preisKlein === null ? (
                            <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                              {kleinPreis}
                            </span>
                          ) : (
                            kleinPreis
                          )}
                        </span>
                        <span class="gericht__preis gericht__preis--gross">
                          <span class="visually-hidden">
                            {kategorie.groessen.gross}:{' '}
                          </span>
                          {gericht.preisGross === null ? (
                            <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                              {grossPreis}
                            </span>
                          ) : (
                            grossPreis
                          )}
                        </span>
                      </>
                    ) : (
                      <span class="gericht__preis gericht__preis--einzel">
                        {gericht.preis === null ? (
                          <span aria-label={texte.speisekarte.preisNichtAngegeben}>
                            {einzelPreis}
                          </span>
                        ) : (
                          einzelPreis
                        )}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}

      {istLangerHinweis && kategorie.hinweis && (
        <details class="extras-details" data-extras-details>
          <summary class="extras-details__summary">
            <span>{texte.speisekarte.extrasTitel}</span>
            <svg
              class="extras-details__chevron"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M6 3.5 10.5 8 6 12.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="extras-details__inhalt" data-extras-inhalt>
            <p class="extras-details__text">{kategorie.hinweis}</p>
          </div>
        </details>
      )}
    </div>
  </div>
</section>

<style>
  .kategorie-sektion {
    --liste-innen: var(--abstand-m);
    --preis-spalte: 4.5rem;
    --preis-gap: 0.5rem;
    scroll-margin-top: 0;
  }

  .kategorie-sektion[hidden] {
    display: none;
  }

  .kategorie-sektion:not([hidden]) ~ .kategorie-sektion:not([hidden]) {
    margin-top: var(--abstand-xl);
  }

  .kategorie-sektion__sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  /* Mitlaufende Kategorie-Überschrift direkt unter Navigationsleiste + Kategorie-Leiste */
  .kategorie-sektion__kopf {
    position: sticky;
    top: calc(var(--nav-hoehe) + var(--katnavi-hoehe));
    z-index: 20;
    padding-block: 0.625rem;
    margin-bottom: var(--abstand-xs);
    background-color: color-mix(in srgb, var(--farbe-offwhite) 86%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 0.5px solid transparent;
    box-shadow: none;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      background-color 200ms ease;
  }

  :global(html.js) .kategorie-sektion__kopf {
    top: calc(var(--nav-hoehe) + var(--katnavi-hoehe) + var(--header-top, 0px));
  }

  @media (max-width: 1023px) {
    :global(html:not(.js)) .kategorie-sektion__kopf {
      top: var(--katnavi-hoehe);
    }
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .kategorie-sektion__kopf {
      background-color: var(--farbe-offwhite);
    }
  }

  .kategorie-sektion__kopf.ist-angeheftet {
    border-bottom-color: var(--farbe-haarlinie);
    box-shadow: var(--schatten-sticky);
  }

  .kategorie-sektion__kopf-innen {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-inline: var(--liste-innen);
  }

  .kategorie-sektion__kopf-innen--groessen {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--preis-spalte) var(--preis-spalte);
    column-gap: var(--preis-gap);
    align-items: baseline;
  }

  .kategorie-sektion__groessen {
    display: contents;
  }

  .kategorie-sektion__groesse {
    text-align: right;
    font-size: var(--text-xs);
    font-weight: var(--gewicht-fett);
    line-height: 1.2;
    color: var(--farbe-text-sekundaer);
    white-space: nowrap;
  }

  /* Heller Listen-Block mit konzentrischen Ecken nach PLAN.md und 4px-Farbakzent oben */
  .kategorie-block {
    --karte-innen: var(--liste-innen);
    --kategorie-akzent: var(--farbe-rot);
    position: relative;
    overflow: clip;
    background-color: var(--farbe-weiss);
    padding: calc(var(--karte-innen) + 4px) var(--karte-innen) var(--karte-innen);
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
    box-shadow:
      0 0 0 1px var(--farbe-haarlinie),
      var(--schatten-liste);
  }

  .kategorie-block::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 4px;
    background-color: var(--kategorie-akzent);
    pointer-events: none;
  }

  .kategorie-block--rot {
    --kategorie-akzent: var(--farbe-rot);
  }

  .kategorie-block--gruen {
    --kategorie-akzent: var(--farbe-gruen);
  }

  .kategorie-block__hinweis {
    padding-bottom: var(--abstand-s);
    margin-bottom: var(--abstand-xs);
    border-bottom: 1px solid var(--farbe-haarlinie);
    font-size: var(--text-m);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  .abschnitt[hidden] {
    display: none;
  }

  .abschnitt:not([hidden]) ~ .abschnitt:not([hidden]) {
    margin-top: var(--abstand-l);
    padding-top: var(--abstand-l);
    border-top: 1px solid var(--farbe-haarlinie);
  }

  .abschnitt__kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem var(--abstand-s);
    margin-bottom: var(--abstand-xs);
  }

  .abschnitt__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: 0.9375rem;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--farbe-text-sekundaer);
  }

  .abschnitt__hinweis {
    font-size: var(--text-m);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  .gerichte-liste {
    list-style: none;
  }

  .gericht {
    display: grid;
    row-gap: var(--abstand-2xs);
    column-gap: var(--preis-gap);
    padding-block: 0.875rem;
    align-items: baseline;
  }

  .gericht[hidden] {
    display: none;
  }

  .gericht:not([hidden]) ~ .gericht:not([hidden]) {
    border-top: 1px solid var(--farbe-haarlinie);
  }

  .gericht--ein-preis {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'kopf preis-einzel'
      'beschreibung beschreibung'
      'kennzeichnung kennzeichnung'
      'teiltreffer teiltreffer';
  }

  .gericht--zwei-preise {
    grid-template-columns: minmax(0, 1fr) var(--preis-spalte) var(--preis-spalte);
    grid-template-areas:
      'kopf preis-klein preis-gross'
      'beschreibung beschreibung beschreibung'
      'kennzeichnung kennzeichnung kennzeichnung'
      'teiltreffer teiltreffer teiltreffer';
  }

  .gericht__kopf {
    grid-area: kopf;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.45rem;
    min-width: 0;
  }

  .gericht__name {
    font-weight: var(--gewicht-fett);
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--farbe-leiste-text);
  }

  .gericht__zusatz {
    font-weight: var(--gewicht-normal);
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--farbe-text-sekundaer);
  }

  .gericht__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    align-self: center;
  }

  .gericht__badge--vegetarisch {
    color: var(--farbe-gruen);
  }

  .gericht__badge--unsicher {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    border: 1px solid var(--farbe-haarlinie-stark);
    font-size: 0.75rem;
    font-weight: var(--gewicht-fett);
    line-height: 1;
    color: var(--farbe-text-sekundaer);
  }

  .gericht__beschreibung {
    grid-area: beschreibung;
    font-weight: var(--gewicht-normal);
    font-size: 0.9375rem;
    line-height: var(--zeilenhoehe);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  .gericht__kennzeichnung {
    grid-area: kennzeichnung;
    font-weight: var(--gewicht-normal);
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  .gericht__teiltreffer {
    grid-area: teiltreffer;
    font-size: var(--text-xs);
    font-weight: var(--gewicht-fett);
    line-height: 1.35;
    color: var(--farbe-rot);
    margin-top: 0.125rem;
    max-width: none;
  }

  .gericht__teiltreffer[hidden] {
    display: none;
  }

  .gericht__preis {
    font-weight: var(--gewicht-fett);
    font-size: 1rem;
    line-height: 1.3;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--farbe-leiste-text);
  }

  .gericht__preis--einzel {
    grid-area: preis-einzel;
  }

  .gericht__preis--klein {
    grid-area: preis-klein;
  }

  .gericht__preis--gross {
    grid-area: preis-gross;
  }

  /* Suchtreffer-Markierung (Elemente werden per DOM erzeugt) */
  .gerichte-liste :global(.gericht__treffer) {
    background-color: var(--farbe-treffer-bg);
    color: var(--farbe-leiste-text);
    border-radius: 4px;
    padding: 0 0.15em;
  }

  /* Aufklappbare Extras & Aufpreise am Ende des Pizza-Blocks */
  .extras-details {
    margin-top: var(--abstand-m);
    border-radius: var(--radius-innen);
    background-color: var(--farbe-suche-bg);
    overflow: hidden;
  }

  .extras-details[hidden] {
    display: none;
  }

  .extras-details__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--abstand-s);
    min-height: 44px;
    padding: var(--abstand-xs) var(--abstand-m);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-m);
    color: var(--farbe-leiste-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition:
      background-color var(--dauer-kurz) ease,
      transform 100ms ease,
      opacity 100ms ease;
  }

  .extras-details__summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .extras-details__summary:hover {
      background-color: var(--farbe-suche-bg-fokus);
    }
  }

  .extras-details__chevron {
    flex-shrink: 0;
    color: var(--farbe-text-sekundaer);
    transition: transform 200ms var(--kurve-ios);
  }

  .extras-details[open] .extras-details__chevron {
    transform: rotate(90deg);
  }

  .extras-details__inhalt {
    overflow: hidden;
  }

  .extras-details__text {
    padding: 0 var(--abstand-m) var(--abstand-m);
    font-size: var(--text-m);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  @media (min-width: 768px) {
    .kategorie-sektion {
      --liste-innen: var(--abstand-l);
      --preis-spalte: 6.25rem;
      --preis-gap: 1.25rem;
    }

    .kategorie-sektion__groesse {
      font-size: var(--text-m);
    }

    .gericht__preis {
      font-size: 1.0625rem;
    }

    .gericht--ein-preis {
      grid-template-areas:
        'kopf preis-einzel'
        'beschreibung preis-einzel'
        'kennzeichnung preis-einzel'
        'teiltreffer preis-einzel';
    }

    .gericht--zwei-preise {
      grid-template-areas:
        'kopf preis-klein preis-gross'
        'beschreibung preis-klein preis-gross'
        'kennzeichnung preis-klein preis-gross'
        'teiltreffer preis-klein preis-gross';
    }

    .gericht__beschreibung {
      max-width: 62ch;
    }
  }

  @media (min-width: 1024px) {
    .kategorie-sektion {
      --liste-innen: 1.75rem;
      --preis-spalte: 7rem;
      --preis-gap: 1.5rem;
    }

    .kategorie-sektion:not([hidden]) ~ .kategorie-sektion:not([hidden]) {
      margin-top: var(--abstand-2xl);
    }

    .kategorie-sektion__kopf {
      padding-block: 0.75rem;
    }

    .gericht {
      padding-block: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kategorie-sektion__kopf,
    .extras-details__summary,
    .extras-details__chevron {
      transition: none;
    }
  }
</style>

---
// Speisekarte: iOS-Navigationsleiste, Large Title, Live-Suche, sticky Kategorie-Navi, helle Listen & Legende
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import KategorieNavi from '../components/speisekarte/KategorieNavi.astro';
import KategorieKarte from '../components/speisekarte/KategorieKarte.astro';
import Legende from '../components/speisekarte/Legende.astro';
import kontakt from '../content/kontakt.json';
import texte from '../content/texte.json';
import speisekarteRoh from '../content/speisekarte.json';
import {
  formatiereStand,
  type SpeisekarteDaten,
} from '../scripts/speisekarte-typen';

const speisekarte: SpeisekarteDaten = speisekarteRoh;

const titel = texte.speisekarte.metaTitel.replace('{name}', kontakt.name);
const naviKategorien = speisekarte.kategorien.map((kat) => ({
  id: kat.id,
  name: kat.name,
}));

const formatierterStand = formatiereStand(speisekarte.stand);
const standText = formatierterStand
  ? texte.speisekarte.standHinweis.replace('{stand}', formatierterStand)
  : texte.speisekarte.standFallback;

const gesamtGerichte = speisekarte.kategorien.reduce(
  (summe, kat) =>
    summe + kat.abschnitte.reduce((s, abs) => s + abs.gerichte.length, 0),
  0,
);
---

<BaseLayout
  title={titel}
  description={texte.speisekarte.metaBeschreibung}
  headerTransparent={false}
  headerVariante="unterseite"
  headerTitel={texte.speisekarte.ueberschrift}
  aktiv="speisekarte"
>
  <div
    class="speisekarte-seite"
    data-speisekarte-seite
    data-anzahl-gesamt={gesamtGerichte}
    data-text-teiltreffer-hinweis={texte.speisekarte.teiltrefferHinweis}
    data-text-teiltreffer-zaehler={texte.speisekarte.teiltrefferZaehler}
    data-text-teiltreffer-ohne={texte.speisekarte.teiltrefferOhne}
    data-text-kein-treffer={texte.speisekarte.keinTreffer}
    data-status-alle={texte.speisekarte.sucheStatusAlle}
    data-status-singular={texte.speisekarte.sucheStatusSingular}
    data-status-plural={texte.speisekarte.sucheStatusPlural}
    data-status-alle-zutaten-singular={texte.speisekarte.sucheStatusAlleZutatenSingular}
    data-status-alle-zutaten-plural={texte.speisekarte.sucheStatusAlleZutatenPlural}
    data-status-teilweise-singular={texte.speisekarte.sucheStatusTeilweiseSingular}
    data-status-teilweise-plural={texte.speisekarte.sucheStatusTeilweisePlural}
    data-status-leer={texte.speisekarte.sucheStatusLeer}
  >
    <header class="speisekarte-kopf">
      <div class="container">
        <div class="speisekarte-kopf__titel-wrap">
          <h1 class="speisekarte-kopf__titel" data-large-title>
            {texte.speisekarte.ueberschrift}
          </h1>
          <p class="speisekarte-kopf__stand">{standText}</p>
        </div>

        <div class="speisekarte-suche" hidden data-suche-box>
          <label for="speisekarte-suche" class="visually-hidden">
            {texte.speisekarte.suchfeldLabel}
          </label>
          <svg
            class="speisekarte-suche__lupe"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="8.75" cy="8.75" r="5.75" stroke="currentColor" stroke-width="2" />
            <path d="m13.25 13.25 3.75 3.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            id="speisekarte-suche"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder={texte.speisekarte.suchfeldPlatzhalter}
            class="speisekarte-suche__eingabe"
            data-suche-eingabe
          />
          <button
            type="button"
            class="speisekarte-suche__leeren"
            hidden
            data-suche-leeren
            aria-label={texte.speisekarte.sucheLeerenLabel}
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <p class="visually-hidden" role="status" aria-live="polite" data-suche-status></p>
      </div>
    </header>

    <KategorieNavi kategorien={naviKategorien} />

    <div class="speisekarte-inhalt" data-speisekarte-inhalt>
      <div class="container">
        <p
          class="teiltreffer-banner"
          hidden
          role="status"
          data-teiltreffer-hinweis
        ></p>
      </div>

      {speisekarte.kategorien.map((kategorie, index) => (
        <KategorieKarte
          kategorie={kategorie}
          farbe={index % 2 === 0 ? 'rot' : 'gruen'}
        />
      ))}

      <div class="container">
        <div class="suche-leer" hidden data-suche-leer>
          <p class="suche-leer__text" data-suche-leer-text></p>
          <Button
            href={kontakt.telefon.link}
            variante="rot"
            groesse="klein"
            icon="telefon"
            ariaLabel={texte.speisekarte.anrufenAriaLabel.replace('{telefon}', kontakt.telefon.anzeige)}
          >
            {texte.speisekarte.keinTrefferButton}
          </Button>
        </div>
      </div>

      <Legende legende={speisekarte.legende} stand={speisekarte.stand} />
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/speisekarte.ts';
</script>

<style>
  .speisekarte-kopf {
    padding-top: var(--abstand-l);
    padding-bottom: var(--abstand-m);
  }

  .speisekarte-kopf__titel-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--abstand-2xs);
  }

  .speisekarte-kopf__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: clamp(2.125rem, 1.8rem + 1.1vw, 2.75rem);
    line-height: 1.1;
    color: var(--farbe-leiste-text);
    transform-origin: left center;
    will-change: transform, opacity;
  }

  .speisekarte-kopf__stand {
    font-size: var(--text-xs);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-text-sekundaer);
    max-width: none;
  }

  /* Suchfeld im iOS-"searchable"-Stil */
  .speisekarte-suche {
    position: relative;
    margin-top: var(--abstand-m);
    display: flex;
    align-items: center;
  }

  .speisekarte-suche[hidden] {
    display: none;
  }

  .speisekarte-suche__lupe {
    position: absolute;
    left: var(--abstand-m);
    color: var(--farbe-text-sekundaer);
    pointer-events: none;
    transition: color 150ms ease;
  }

  .speisekarte-suche:focus-within .speisekarte-suche__lupe {
    color: var(--farbe-rot);
  }

  .speisekarte-suche__eingabe {
    width: 100%;
    height: 2.75rem;
    min-height: 44px;
    padding-block: 0;
    padding-inline: 2.875rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--farbe-suche-bg);
    color: var(--farbe-leiste-text);
    font-family: var(--schrift-basis);
    font-size: max(1rem, var(--text-basis));
    font-weight: var(--gewicht-normal);
    line-height: 1.3;
    transition: background-color 150ms ease;
  }

  .speisekarte-suche__eingabe::placeholder {
    color: var(--farbe-text-sekundaer);
  }

  .speisekarte-suche__eingabe:focus {
    background-color: var(--farbe-suche-bg-fokus);
  }

  .speisekarte-suche__eingabe::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .speisekarte-suche__leeren {
    position: absolute;
    right: 0;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--farbe-text-sekundaer);
    font-size: 1.375rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      color var(--dauer-kurz) ease,
      transform 100ms ease;
  }

  .speisekarte-suche__leeren[hidden] {
    display: none;
  }

  .speisekarte-suche__leeren:active {
    transform: scale(0.96);
  }

  @media (hover: hover) {
    .speisekarte-suche__leeren:hover {
      color: var(--farbe-leiste-text);
    }
  }

  .speisekarte-inhalt {
    padding-top: var(--abstand-m);
    padding-bottom: var(--abstand-2xl);
  }

  .teiltreffer-banner {
    margin-bottom: var(--abstand-m);
    padding: var(--abstand-s) var(--abstand-m);
    border-radius: var(--radius-innen);
    background-color: var(--farbe-weiss);
    box-shadow:
      0 0 0 1px var(--farbe-haarlinie),
      var(--schatten-liste);
    border-left: 3px solid var(--farbe-rot);
    font-size: var(--text-m);
    font-weight: var(--gewicht-fett);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-leiste-text);
    max-width: none;
  }

  .teiltreffer-banner[hidden] {
    display: none;
  }

  .suche-leer {
    --karte-innen: var(--abstand-l);
    margin-top: var(--abstand-m);
    padding: var(--karte-innen);
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
    background-color: var(--farbe-weiss);
    box-shadow:
      0 0 0 1px var(--farbe-haarlinie),
      var(--schatten-liste);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--abstand-m);
  }

  .suche-leer[hidden] {
    display: none;
  }

  .suche-leer__text {
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
    color: var(--farbe-leiste-text);
    max-width: 48ch;
  }

  .suche-leer :global(.btn:active) {
    transform: scale(0.96);
  }

  @media (min-width: 1024px) {
    .speisekarte-kopf {
      padding-top: var(--abstand-xl);
      padding-bottom: var(--abstand-l);
    }

    .speisekarte-suche {
      max-width: 34rem;
    }

    .speisekarte-inhalt {
      padding-top: var(--abstand-l);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speisekarte-suche__lupe,
    .speisekarte-suche__eingabe,
    .speisekarte-suche__leeren {
      transition: none;
    }
  }
</style>

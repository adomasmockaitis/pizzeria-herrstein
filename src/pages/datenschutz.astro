---
// Datenschutzerklärung: Unterseite passend zur tatsächlichen Technik, mit Entwurfs-Hinweis im DEMO_MODE und Inhaltsverzeichnis
import BaseLayout from '../layouts/BaseLayout.astro';
import AbschnittTitel from '../components/AbschnittTitel.astro';
import { DEMO_MODE } from '../config';
import kontakt from '../content/kontakt.json';
import rechtliches from '../content/rechtliches.json';

const t = rechtliches.datenschutz;
const metaTitel = t.metaTitel.replace('{name}', kontakt.name);
const metaBeschreibung = t.metaBeschreibung.replace('{name}', kontakt.name);

const inhaltsverzeichnis = [
  { id: t.verantwortlicher.id, titel: t.verantwortlicher.titel },
  { id: t.hosting.id, titel: t.hosting.titel },
  { id: t.keineCookies.id, titel: t.keineCookies.titel },
  { id: t.schriften.id, titel: t.schriften.titel },
  { id: t.sessionStorage.id, titel: t.sessionStorage.titel },
  { id: t.externeLinks.id, titel: t.externeLinks.titel },
  { id: t.kontakt.id, titel: t.kontakt.titel },
  { id: t.rechte.id, titel: t.rechte.titel },
];
---

<BaseLayout
  title={metaTitel}
  description={metaBeschreibung}
  headerTransparent={false}
  headerVariante="unterseite"
  headerTitel={t.headerTitel}
>
  <div class="rechtliches-seite">
    <header class="unterseite-kopf">
      <div class="container">
        <div class="unterseite-kopf__titel-wrap">
          <h1 class="unterseite-kopf__titel" data-large-title>
            {t.ueberschrift}
          </h1>
          <div class="unterseite-kopf__trikolore" aria-hidden="true">
            <span class="unterseite-kopf__trikolore-gruen"></span>
            <span class="unterseite-kopf__trikolore-weiss"></span>
            <span class="unterseite-kopf__trikolore-rot"></span>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      {DEMO_MODE && (
        <aside class="entwurf-kasten" role="note">
          <p class="entwurf-kasten__text">{t.demoHinweis}</p>
        </aside>
      )}

      <article class="rechtliches-box" aria-label={t.ueberschrift}>
        <nav class="inhaltsverzeichnis" aria-label={t.inhaltsverzeichnisLabel}>
          <p class="inhaltsverzeichnis__titel">{t.inhaltsverzeichnisTitel}</p>
          <ol class="inhaltsverzeichnis__liste">
            {inhaltsverzeichnis.map((punkt) => (
              <li>
                <a href={`#${punkt.id}`} class="inhaltsverzeichnis__link">
                  {punkt.titel}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <section id={t.verantwortlicher.id} class="rechtliches-abschnitt" aria-labelledby="ds-verantwortlicher">
          <AbschnittTitel id="ds-verantwortlicher" as="h2" variante="kompakt" farbe="rot" class="rechtliches-abschnitt__titel">
            {t.verantwortlicher.titel}
          </AbschnittTitel>
          <p>{t.verantwortlicher.intro}</p>
          <p>
            <strong>{t.verantwortlicher.label}</strong><br />
            <mark class="todo">{t.verantwortlicher.todo}</mark>
          </p>
        </section>

        <section id={t.hosting.id} class="rechtliches-abschnitt" aria-labelledby="ds-hosting">
          <AbschnittTitel id="ds-hosting" as="h2" variante="kompakt" farbe="rot" class="rechtliches-abschnitt__titel">
            {t.hosting.titel}
          </AbschnittTitel>
          <p>{t.hosting.statischText}</p>
          <p>{t.hosting.githubText}</p>
          <p>{t.hosting.rechtsgrundlage}</p>
          <p>{t.hosting.usaHinweis}</p>
          <p>
            <a
              href={t.hosting.githubLinkUrl}
              class="text-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t.hosting.githubLinkText} ${t.externerLinkHinweis}`}
            >
              {t.hosting.githubLinkText}
            </a>
          </p>
          <p>
            {t.hosting.livegangHinweis}{' '}
            <mark class="todo">{t.hosting.livegangTodo}</mark>
          </p>
        </section>

        <section id={t.keineCookies.id} class="rechtliches-abschnitt" aria-labelledby="ds-keine-cookies">
          <AbschnittTitel id="ds-keine-cookies" as="h2" variante="kompakt" farbe="gruen" class="rechtliches-abschnitt__titel">
            {t.keineCookies.titel}
          </AbschnittTitel>
          <p>{t.keineCookies.text}</p>
        </section>

        <section id={t.schriften.id} class="rechtliches-abschnitt" aria-labelledby="ds-schriften">
          <AbschnittTitel id="ds-schriften" as="h2" variante="kompakt" farbe="gruen" class="rechtliches-abschnitt__titel">
            {t.schriften.titel}
          </AbschnittTitel>
          <p>{t.schriften.text}</p>
        </section>

        <section id={t.sessionStorage.id} class="rechtliches-abschnitt" aria-labelledby="ds-session-storage">
          <AbschnittTitel id="ds-session-storage" as="h2" variante="kompakt" farbe="rot" class="rechtliches-abschnitt__titel">
            {t.sessionStorage.titel}
          </AbschnittTitel>
          <p>{t.sessionStorage.text}</p>
        </section>

        <section id={t.externeLinks.id} class="rechtliches-abschnitt" aria-labelledby="ds-externe-links">
          <AbschnittTitel id="ds-externe-links" as="h2" variante="kompakt" farbe="rot" class="rechtliches-abschnitt__titel">
            {t.externeLinks.titel}
          </AbschnittTitel>
          <p>{t.externeLinks.intro}</p>
          <ul class="rechtliches-liste">
            {t.externeLinks.eintraege.map((eintrag) => (
              <li>
                <strong>{eintrag.name}:</strong> {eintrag.beschreibung}
                {eintrag.linkUrl && eintrag.linkText && (
                  <>
                    {' '}
                    <a
                      href={eintrag.linkUrl}
                      class="text-link"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${eintrag.linkText} ${t.externerLinkHinweis}`}
                    >
                      {eintrag.linkText}
                    </a>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>

        <section id={t.kontakt.id} class="rechtliches-abschnitt" aria-labelledby="ds-kontakt">
          <AbschnittTitel id="ds-kontakt" as="h2" variante="kompakt" farbe="gruen" class="rechtliches-abschnitt__titel">
            {t.kontakt.titel}
          </AbschnittTitel>
          <p>{t.kontakt.text}</p>
          <p>{t.kontakt.whatsappText}</p>
          <p>
            <a
              href={t.kontakt.whatsappLinkUrl}
              class="text-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t.kontakt.whatsappLinkText} ${t.externerLinkHinweis}`}
            >
              {t.kontakt.whatsappLinkText}
            </a>
          </p>
        </section>

        <section id={t.rechte.id} class="rechtliches-abschnitt" aria-labelledby="ds-rechte">
          <AbschnittTitel id="ds-rechte" as="h2" variante="kompakt" farbe="rot" class="rechtliches-abschnitt__titel">
            {t.rechte.titel}
          </AbschnittTitel>
          <p>{t.rechte.intro}</p>
          <ul class="rechtliches-liste">
            {t.rechte.liste.map((recht) => (
              <li>
                <strong>{recht.titel}</strong> {recht.text}
              </li>
            ))}
          </ul>

          <h3 class="rechtliches-untertitel">{t.rechte.beschwerdeTitel}</h3>
          <p>{t.rechte.beschwerdeIntro}</p>
          <address class="rechtliches-adresse">
            <p><strong>{t.rechte.behoerdeName}</strong></p>
            <p>{t.rechte.behoerdeAdresse}</p>
            <p>
              <a
                href={t.rechte.behoerdeLinkUrl}
                class="text-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t.rechte.behoerdeLinkText} ${t.externerLinkHinweis}`}
              >
                {t.rechte.behoerdeLinkText}
              </a>
            </p>
          </address>
        </section>

        <footer class="rechtliches-stand">
          <p>
            <strong>{t.standLabel}</strong>{' '}
            <mark class="todo">{t.standTodo}</mark>
          </p>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  // Large-Title-Verhalten wie auf /speisekarte (kompakter Titel in der Navigationsleiste beim Scrollen)
  const largeTitle = document.querySelector<HTMLElement>('[data-large-title]');
  const navTitel = document.querySelector<HTMLElement>('[data-nav-titel]');
  const headerEl = document.querySelector<HTMLElement>('.header--unterseite');
  const reduziertMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (largeTitle && navTitel) {
    const aktualisiere = () => {
      if (reduziertMedia.matches) {
        largeTitle.style.transform = '';
        largeTitle.style.opacity = '';
        const navUnten = headerEl?.getBoundingClientRect().bottom ?? 56;
        navTitel.classList.toggle('ist-sichtbar', largeTitle.getBoundingClientRect().bottom <= navUnten + 4);
        return;
      }
      const fortschritt = Math.min(1, Math.max(0, window.scrollY / 80));
      const skala = 1 - fortschritt * 0.08;
      largeTitle.style.transform = fortschritt > 0.001 ? `scale(${skala.toFixed(4)})` : '';
      largeTitle.style.opacity = fortschritt > 0.001 ? (1 - fortschritt).toFixed(3) : '';
      navTitel.classList.toggle('ist-sichtbar', fortschritt >= 0.65);
    };

    let rahmen = false;
    const beiScroll = () => {
      if (rahmen) return;
      rahmen = true;
      window.requestAnimationFrame(() => {
        rahmen = false;
        aktualisiere();
      });
    };

    aktualisiere();
    window.addEventListener('scroll', beiScroll, { passive: true });
    window.addEventListener('resize', beiScroll, { passive: true });
    reduziertMedia.addEventListener('change', aktualisiere);
  }
</script>

<style>
  .rechtliches-seite {
    padding-bottom: var(--abstand-2xl);
  }

  .unterseite-kopf {
    padding-top: var(--abstand-l);
    padding-bottom: var(--abstand-m);
  }

  .unterseite-kopf__titel-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--abstand-2xs);
  }

  .unterseite-kopf__titel {
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: clamp(1.875rem, 1.55rem + 1.3vw, 2.75rem);
    line-height: 1.1;
    color: var(--farbe-leiste-text);
    overflow-wrap: break-word;
    hyphens: auto;
    transform-origin: left center;
    will-change: transform, opacity;
  }

  .unterseite-kopf__trikolore {
    width: 6rem;
    height: 4px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--schatten-klein);
    margin-block: var(--abstand-2xs);
  }

  .unterseite-kopf__trikolore-gruen {
    background-color: var(--farbe-gruen-figma);
  }

  .unterseite-kopf__trikolore-weiss {
    background-color: var(--farbe-weiss);
    box-shadow: inset 0 0 0 1px var(--farbe-haarlinie);
  }

  .unterseite-kopf__trikolore-rot {
    background-color: var(--farbe-rot);
  }

  /* Deutlich sichtbarer Entwurfs-Kasten im DEMO_MODE (Kontrast > 8:1) */
  .entwurf-kasten {
    margin-bottom: var(--abstand-l);
    padding: var(--abstand-m) var(--abstand-l);
    border-radius: var(--radius-innen);
    border: 2px solid var(--farbe-status-bald-rand);
    border-left-width: 6px;
    background-color: #fff8dc;
    color: #4a3000;
    box-shadow: var(--schatten-liste);
  }

  .entwurf-kasten__text {
    font-weight: var(--gewicht-fett);
    font-size: var(--text-basis);
    line-height: var(--zeilenhoehe);
    max-width: 70ch;
  }

  /* Heller Inhaltsblock mit konzentrischen Ecken */
  .rechtliches-box {
    --karte-innen: var(--abstand-m);
    padding: var(--karte-innen);
    border-radius: calc(var(--karte-innen) + var(--radius-innen));
    background-color: var(--farbe-weiss);
    color: var(--farbe-leiste-text);
    box-shadow:
      0 0 0 1px var(--farbe-haarlinie),
      var(--schatten-liste);
    display: flex;
    flex-direction: column;
    gap: var(--abstand-xl);
  }

  @media (min-width: 768px) {
    .rechtliches-box {
      --karte-innen: var(--abstand-xl);
    }
  }

  /* Inhaltsverzeichnis am Anfang */
  .inhaltsverzeichnis {
    padding: var(--abstand-m);
    border-radius: var(--radius-innen);
    background-color: var(--farbe-offwhite);
    border: 1px solid var(--farbe-haarlinie);
  }

  .inhaltsverzeichnis__titel {
    font-size: var(--text-s);
    font-weight: var(--gewicht-fett);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--farbe-text-sekundaer);
    margin-bottom: var(--abstand-xs);
  }

  .inhaltsverzeichnis__liste {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--abstand-2xs);
  }

  @media (min-width: 768px) {
    .inhaltsverzeichnis__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--abstand-xs) var(--abstand-l);
    }
  }

  .inhaltsverzeichnis__link {
    display: inline-flex;
    align-items: center;
    padding-block: 0.25rem;
    color: var(--farbe-rot);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-m);
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  @media (hover: hover) {
    .inhaltsverzeichnis__link:hover {
      color: var(--farbe-rot-dunkel);
    }
  }

  .rechtliches-abschnitt {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-s);
    scroll-margin-top: calc(var(--aktuelle-leiste-hoehe) + 1rem);
  }

  .rechtliches-abschnitt + .rechtliches-abschnitt {
    padding-top: var(--abstand-l);
    border-top: 1px solid var(--farbe-haarlinie);
  }

  .rechtliches-abschnitt__titel {
    margin-bottom: var(--abstand-2xs);
  }

  .rechtliches-untertitel {
    margin-top: var(--abstand-s);
    font-family: var(--schrift-basis);
    font-weight: var(--gewicht-fett);
    font-size: var(--text-l);
    line-height: 1.25;
    color: var(--farbe-leiste-text);
  }

  .rechtliches-liste {
    max-width: 70ch;
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-s);
  }

  .rechtliches-adresse {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--abstand-2xs);
    max-width: 70ch;
  }

  .rechtliches-stand {
    padding-top: var(--abstand-l);
    border-top: 1px solid var(--farbe-haarlinie);
    color: var(--farbe-text-sekundaer);
  }

  .text-link {
    color: var(--farbe-rot);
    font-weight: var(--gewicht-fett);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  @media (hover: hover) {
    .text-link:hover {
      color: var(--farbe-rot-dunkel);
    }
  }
</style>

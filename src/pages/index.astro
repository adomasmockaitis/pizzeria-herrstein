---
// Startseite: Zusammenspiel der 5 Sektionen mit Schema.org-Restaurant-Metadaten
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/startseite/Hero.astro';
import Genuss from '../components/startseite/Genuss.astro';
import Lieferservice from '../components/startseite/Lieferservice.astro';
import Lieferkosten from '../components/startseite/Lieferkosten.astro';
import OeffnungszeitenKontakt from '../components/startseite/OeffnungszeitenKontakt.astro';
import kontakt from '../content/kontakt.json';
import oeffnungszeiten from '../content/oeffnungszeiten.json';
import texte from '../content/texte.json';

const schemaTagMap: Record<string, string> = {
  Montag: 'Monday',
  Dienstag: 'Tuesday',
  Mittwoch: 'Wednesday',
  Donnerstag: 'Thursday',
  Freitag: 'Friday',
  Samstag: 'Saturday',
  Sonntag: 'Sunday',
};

const openingHoursSpecification = oeffnungszeiten.tage.flatMap((eintrag) => {
  if (eintrag.ruhetag || eintrag.zeiten.length === 0) {
    return [];
  }
  const dayOfWeek = schemaTagMap[eintrag.tag] ?? eintrag.tag;
  return eintrag.zeiten.map((spanne) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek,
    opens: spanne.von,
    closes: spanne.bis,
  }));
});

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const startseiteUrl = Astro.site ? new URL(base, Astro.site).href : undefined;

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: kontakt.name,
  ...(startseiteUrl && {
    url: startseiteUrl,
    hasMenu: new URL('speisekarte/', startseiteUrl).href,
  }),
  servesCuisine: 'Italienisch',
  telephone: kontakt.telefon.anzeige,
  address: {
    '@type': 'PostalAddress',
    streetAddress: kontakt.adresse.strasse,
    postalCode: kontakt.adresse.plz,
    addressLocality: kontakt.adresse.ort,
    addressCountry: 'DE',
  },
  openingHoursSpecification,
};
---

<BaseLayout
  title={kontakt.name}
  description={texte.meta.beschreibung}
  headerTransparent={true}
  aktiv="home"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
  <Hero />
  <Genuss />
  <Lieferservice />
  <Lieferkosten />
  <OeffnungszeitenKontakt />
</BaseLayout>
